---
import type { Lang } from "../data/landing";
import { home, launch } from "../data/landing";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import Countdown from "./Countdown.astro";
import PhoneMockup from "./PhoneMockup.astro";
import OnionPathDiagram from "./OnionPathDiagram.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = home[lang];
const l = launch[lang];
const prefix = lang === "es" ? "/es" : "";
const networkHref = `${prefix}/network/`;
const coinHref = `${prefix}/coin/`;

// Icons for the six privacy benefits, in order.
const benefitIcons = ["id", "onion", "server", "lock", "device", "code"];

const ic = (path: string) =>
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${path}</svg>`;

function icon(name: string): string {
  switch (name) {
    case "id":
      return ic('<rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="12" r="2.2"/><line x1="14" y1="10.5" x2="18" y2="10.5"/><line x1="14" y1="14" x2="17" y2="14"/>');
    case "onion":
      return ic('<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5.5"/><circle cx="12" cy="12" r="2"/>');
    case "server":
      return ic('<rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><line x1="7" y1="7.5" x2="7" y2="7.5"/><line x1="7" y1="16.5" x2="7" y2="16.5"/>');
    case "lock":
      return ic('<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>');
    case "device":
      return ic('<rect x="3" y="4" width="13" height="10" rx="2"/><rect x="15" y="9" width="6" height="11" rx="1.6"/><line x1="7" y1="18" x2="11" y2="18"/>');
    case "code":
      return ic('<polyline points="8 7 3 12 8 17"/><polyline points="16 7 21 12 16 17"/>');
    default:
      return ic('<circle cx="12" cy="12" r="9"/>');
  }
}

// Decorative art for each feature row, keyed by index (tag text is localized).
function featureArt(index: number): string {
  if (index === 0) {
    return `<svg width="220" height="150" viewBox="0 0 220 150" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="20" y="22" width="180" height="106" rx="14" fill="rgba(255,140,0,0.05)" stroke="#FF8C00" stroke-width="1.4"/>
      <circle cx="56" cy="58" r="16" fill="rgba(255,140,0,0.12)" stroke="#FF8C00" stroke-width="1.4"/>
      <path d="M40 92c0-9 7-15 16-15s16 6 16 15" stroke="#FF8C00" stroke-width="1.4" fill="none"/>
      <rect x="90" y="48" width="92" height="9" rx="4.5" fill="rgba(255,255,255,0.12)"/>
      <rect x="90" y="66" width="64" height="9" rx="4.5" fill="rgba(255,255,255,0.08)"/>
      <text x="40" y="116" font-family="ui-monospace, monospace" font-size="11" fill="#FF8C00">05a3f…9c2</text>
    </svg>`;
  }
  if (index === 1) {
    return `<svg width="220" height="150" viewBox="0 0 220 150" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="40" cy="75" r="14" fill="rgba(255,140,0,0.12)" stroke="#FF8C00" stroke-width="1.4"/>
      <circle cx="110" cy="75" r="13" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.25)" stroke-width="1.3"/>
      <circle cx="180" cy="75" r="14" fill="rgba(255,140,0,0.12)" stroke="#FF8C00" stroke-width="1.4"/>
      <line x1="54" y1="75" x2="97" y2="75" stroke="#FF8C00" stroke-width="1.6" stroke-dasharray="5 4"/>
      <line x1="123" y1="75" x2="166" y2="75" stroke="#FF8C00" stroke-width="1.6" stroke-dasharray="5 4"/>
      <text x="40" y="110" font-family="Inter, sans-serif" font-size="10" font-weight="600" fill="#888" text-anchor="middle">IP</text>
      <text x="180" y="110" font-family="Inter, sans-serif" font-size="10" font-weight="600" fill="#888" text-anchor="middle">?</text>
    </svg>`;
  }
  if (index === 2) {
    return `<svg width="220" height="150" viewBox="0 0 220 150" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="24" y="40" width="74" height="50" rx="8" fill="rgba(255,140,0,0.05)" stroke="#FF8C00" stroke-width="1.4"/>
      <rect x="132" y="34" width="40" height="64" rx="8" fill="rgba(255,140,0,0.05)" stroke="#FF8C00" stroke-width="1.4"/>
      <path d="M98 65h34" stroke="#FF8C00" stroke-width="1.6" stroke-dasharray="5 4"/>
      <circle cx="115" cy="65" r="3" fill="#FF8C00"/>
      <rect x="36" y="54" width="40" height="6" rx="3" fill="rgba(255,255,255,0.12)"/>
      <rect x="36" y="68" width="28" height="6" rx="3" fill="rgba(255,255,255,0.08)"/>
      <rect x="142" y="48" width="20" height="5" rx="2.5" fill="rgba(255,255,255,0.12)"/>
      <rect x="142" y="60" width="14" height="5" rx="2.5" fill="rgba(255,255,255,0.08)"/>
    </svg>`;
  }
  if (index === 3) {
    return `<svg width="220" height="150" viewBox="0 0 220 150" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="110" cy="52" r="18" fill="rgba(255,140,0,0.14)" stroke="#FF8C00" stroke-width="1.5"/>
      <circle cx="66" cy="88" r="14" fill="rgba(255,140,0,0.10)" stroke="#FF8C00" stroke-width="1.3"/>
      <circle cx="154" cy="88" r="14" fill="rgba(255,140,0,0.10)" stroke="#FF8C00" stroke-width="1.3"/>
      <circle cx="34" cy="60" r="11" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.22)" stroke-width="1.2"/>
      <circle cx="186" cy="60" r="11" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.22)" stroke-width="1.2"/>
      <line x1="93" y1="63" x2="78" y2="79" stroke="#FF8C00" stroke-width="1.4" stroke-dasharray="4 3"/>
      <line x1="127" y1="63" x2="142" y2="79" stroke="#FF8C00" stroke-width="1.4" stroke-dasharray="4 3"/>
      <line x1="44" y1="65" x2="56" y2="78" stroke="rgba(255,255,255,0.18)" stroke-width="1.2" stroke-dasharray="4 3"/>
      <line x1="176" y1="65" x2="164" y2="78" stroke="rgba(255,255,255,0.18)" stroke-width="1.2" stroke-dasharray="4 3"/>
      <text x="110" y="138" font-family="ui-monospace, monospace" font-size="10" fill="rgba(255,140,0,0.7)" text-anchor="middle">group · community</text>
    </svg>`;
  }
  // Calls / onion-routed audio (in development)
  return `<svg width="220" height="150" viewBox="0 0 220 150" fill="none" xmlns="http://www.w3.org/2000/svg">
    <rect x="78" y="24" width="64" height="102" rx="14" fill="rgba(255,140,0,0.05)" stroke="#FF8C00" stroke-width="1.4"/>
    <circle cx="110" cy="64" r="20" fill="rgba(255,140,0,0.10)" stroke="#FF8C00" stroke-width="1.3"/>
    <rect x="106" y="52" width="8" height="14" rx="4" fill="rgba(255,140,0,0.3)" stroke="#FF8C00" stroke-width="1.3"/>
    <path d="M104 70v2a6 6 0 0 0 12 0v-2" stroke="#FF8C00" stroke-width="1.4" fill="none" stroke-linecap="round"/>
    <line x1="110" y1="78" x2="110" y2="83" stroke="#FF8C00" stroke-width="1.4" stroke-linecap="round"/>
    <line x1="105" y1="83" x2="115" y2="83" stroke="#FF8C00" stroke-width="1.4" stroke-linecap="round"/>
    <path d="M142 56 Q152 64 152 75 Q152 86 142 94" stroke="#FF8C00" stroke-width="1.5" fill="none" stroke-linecap="round"/>
    <path d="M150 48 Q164 64 164 75 Q164 86 150 102" stroke="rgba(255,140,0,0.45)" stroke-width="1.3" fill="none" stroke-linecap="round"/>
    <rect x="96" y="112" width="28" height="5" rx="2.5" fill="rgba(255,255,255,0.12)"/>
  </svg>`;
}

// Roadmap state → dot color class.
const stateClass: Record<string, string> = {
  done: "is-done",
  progress: "is-progress",
  soon: "is-soon",
};
---

<SiteHeader lang={lang} page="home" />

<main class="page">
  <!-- ── Hero ── -->
  <section class="hero">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="hero__copy">
      <span class="eyebrow">{l.badge}</span>
      <h1 class="hero__title">{t.hero.title}</h1>
      <p class="hero__subtitle">{t.hero.subtitle}</p>
      <div class="hero__countdown">
        <Countdown lang={lang} />
      </div>
      <div class="hero__actions">
        <a href="https://github.com/almena-network" class="btn btn--primary" target="_blank" rel="noopener">{t.hero.ctaPrimary}</a>
        <a href="#roadmap" class="btn btn--ghost">{t.hero.ctaSecondary}</a>
      </div>
    </div>
    <div class="hero__visual">
      <PhoneMockup lang={lang} />
    </div>
  </section>

  <!-- ── Roadmap / status ── -->
  <section class="roadmap" id="roadmap" aria-labelledby="roadmap-heading">
    <div class="section-head">
      <h2 id="roadmap-heading" class="section-head__title">{t.roadmap.title}</h2>
      <p class="section-head__subtitle">{t.roadmap.subtitle}</p>
    </div>
    <ol class="roadmap__grid">
      {t.roadmap.items.map((item) => (
        <li class={`roadmap-card ${stateClass[item.state] ?? ""}`}>
          <span class="roadmap-card__label">
            <span class="roadmap-card__dot" aria-hidden="true"></span>
            {item.label}
          </span>
          <h3 class="roadmap-card__title">{item.title}</h3>
          <p class="roadmap-card__text">{item.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- ── Platforms ── -->
  <section class="platforms">
    <h2 class="platforms__title">{t.platforms.title}</h2>
    <p class="platforms__subtitle">{t.platforms.subtitle}</p>
    <ul class="platforms__list">
      {t.platforms.items.map((p) => (
        <li class="platform-chip">
          <span class="platform-chip__name">{p.name}</span>
          <span class="platform-chip__kind">{p.kind}</span>
        </li>
      ))}
    </ul>
    <span class="platforms__note">{t.platforms.note}</span>
  </section>

  <!-- ── What is Almena ── -->
  <section class="what">
    <h2 class="what__title">{t.what.title}</h2>
    <p class="what__text">{t.what.text}</p>
  </section>

  <!-- ── Privacy benefits ── -->
  <section class="benefits" aria-labelledby="benefits-heading">
    <div class="section-head">
      <h2 id="benefits-heading" class="section-head__title">{t.benefits.title}</h2>
      <p class="section-head__subtitle">{t.benefits.subtitle}</p>
    </div>
    <div class="benefits__grid">
      {t.benefits.items.map((item, i) => (
        <article class="benefit-card">
          <div class="benefit-card__icon" aria-hidden="true" set:html={icon(benefitIcons[i])} />
          <h3 class="benefit-card__title">{item.title}</h3>
          <p class="benefit-card__text">{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- ── Onion routing diagram ── -->
  <section class="diagram-section">
    <OnionPathDiagram lang={lang} />
  </section>

  <!-- ── Feature blocks (alternating) ── -->
  <section class="features" aria-labelledby="features-heading">
    <div class="section-head">
      <h2 id="features-heading" class="section-head__title">{t.features.title}</h2>
    </div>
    <div class="features__list">
      {t.features.items.map((f, i) => (
        <article class={`feature-row${i % 2 === 1 ? " feature-row--reverse" : ""}`}>
          <div class="feature-row__body">
            <span class="feature-row__tag">{f.tag}</span>
            <h3 class="feature-row__title">{f.title}</h3>
            <p class="feature-row__text">{f.text}</p>
            <ul class="feature-row__points">
              {f.points.map((pt) => (
                <li>
                  <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  {pt}
                </li>
              ))}
            </ul>
          </div>
          <div class="feature-row__visual" aria-hidden="true">
            <div class="feature-row__visual-inner" set:html={featureArt(i)} />
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ── Network + Coin teasers ── -->
  <section class="teasers">
    <a href={networkHref} class="teaser-card">
      <span class="teaser-card__eyebrow">{t.networkTeaser.eyebrow}</span>
      <h2 class="teaser-card__title">{t.networkTeaser.title}</h2>
      <p class="teaser-card__text">{t.networkTeaser.text}</p>
      <span class="teaser-card__cta">{t.networkTeaser.cta} →</span>
    </a>
    <a href={coinHref} class="teaser-card teaser-card--coin">
      <span class="teaser-card__eyebrow">{t.coinTeaser.eyebrow}</span>
      <h2 class="teaser-card__title">{t.coinTeaser.title}</h2>
      <p class="teaser-card__text">{t.coinTeaser.text}</p>
      <span class="teaser-card__cta">{t.coinTeaser.cta} →</span>
    </a>
  </section>

  <!-- ── Community CTA ── -->
  <section class="community">
    <h2 class="community__title">{t.community.title}</h2>
    <p class="community__text">{t.community.text}</p>
    <div class="community__actions">
      <a href="https://github.com/almena-network" class="btn btn--primary" target="_blank" rel="noopener">{t.community.ctaPrimary}</a>
      <a href="https://docs.almena.network" class="btn btn--ghost" target="_blank" rel="noopener">{t.community.ctaSecondary}</a>
    </div>
  </section>
</main>

<SiteFooter lang={lang} />

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
    padding: 80px 0 90px;
  }

  .hero__glow {
    position: absolute;
    top: -60px;
    left: -5%;
    width: 720px;
    height: 460px;
    max-width: 100%;
    background: radial-gradient(ellipse at center, rgba(255, 140, 0, 0.14) 0%, transparent 65%);
    pointer-events: none;
    z-index: -1;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero__title {
    font-size: clamp(2.4rem, 5.5vw, 4rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin: 22px 0;
    background: linear-gradient(170deg, #ffffff 0%, rgba(255, 255, 255, 0.72) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero__subtitle {
    font-size: clamp(1rem, 2vw, 1.1875rem);
    color: var(--color-text-muted);
    margin: 0 0 32px;
    max-width: 52ch;
    line-height: 1.65;
  }

  .hero__countdown {
    align-self: stretch;
    margin-bottom: 32px;
  }

  .hero__countdown :global(.countdown) {
    align-items: flex-start;
  }

  .hero__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .hero__visual {
    display: flex;
    justify-content: center;
  }

  /* ── Roadmap ── */
  .roadmap {
    padding: 0 0 90px;
  }

  .roadmap__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .roadmap-card {
    padding: 24px;
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius);
  }

  .roadmap-card__label {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: 14px;
  }

  .roadmap-card__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-text-subtle);
  }

  .roadmap-card.is-done .roadmap-card__dot { background: var(--semantic-success); }
  .roadmap-card.is-done .roadmap-card__label { color: var(--semantic-success); }
  .roadmap-card.is-progress .roadmap-card__dot { background: var(--semantic-warning); }
  .roadmap-card.is-progress .roadmap-card__label { color: var(--semantic-warning); }
  .roadmap-card.is-soon .roadmap-card__dot { background: var(--brand-primary); }
  .roadmap-card.is-soon .roadmap-card__label { color: var(--brand-primary); }

  .roadmap-card__title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 8px;
    color: var(--color-text);
  }

  .roadmap-card__text {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.55;
  }

  /* ── Platforms ── */
  .platforms {
    text-align: center;
    padding: 0 0 90px;
  }

  .platforms__title {
    font-size: 1.375rem;
    font-weight: 700;
    margin: 0 0 8px;
    color: var(--color-text);
  }

  .platforms__subtitle {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0 auto 28px;
    max-width: 52ch;
  }

  .platforms__list {
    list-style: none;
    margin: 0 0 20px;
    padding: 0;
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .platform-chip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 14px 26px;
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius);
    transition: border-color var(--transition), transform var(--transition);
  }

  .platform-chip:hover {
    border-color: rgba(255, 140, 0, 0.3);
    transform: translateY(-2px);
  }

  .platform-chip__name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .platform-chip__kind {
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-subtle);
  }

  .platforms__note {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--brand-primary);
    padding: 5px 12px;
    border: 1px solid rgba(255, 140, 0, 0.22);
    border-radius: 100px;
    background: var(--brand-primary-subtle);
  }

  /* ── What ── */
  .what {
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
    padding: 0 0 90px;
  }

  .what__title {
    font-size: clamp(1.6rem, 3.2vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 0 0 18px;
    color: var(--color-text);
  }

  .what__text {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.7;
  }

  /* ── Benefits ── */
  .benefits {
    padding: 0 0 90px;
  }

  .benefits__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .benefit-card {
    padding: 26px;
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius);
    transition: border-color var(--transition), transform var(--transition);
  }

  .benefit-card:hover {
    border-color: rgba(255, 140, 0, 0.25);
    transform: translateY(-2px);
  }

  .benefit-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 11px;
    background: var(--brand-primary-subtle);
    color: var(--brand-primary);
    margin-bottom: 16px;
    border: 1px solid rgba(255, 140, 0, 0.16);
  }

  .benefit-card__title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 8px;
    color: var(--color-text);
  }

  .benefit-card__text {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.55;
  }

  /* ── Diagram ── */
  .diagram-section {
    padding: 0 0 90px;
  }

  /* ── Feature rows ── */
  .features {
    padding: 0 0 90px;
  }

  .features__list {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .feature-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
    padding: 36px;
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
  }

  .feature-row--reverse .feature-row__body {
    order: 2;
  }

  .feature-row__tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--brand-primary);
    margin-bottom: 12px;
  }

  .feature-row__title {
    font-size: clamp(1.35rem, 2.6vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 14px;
    color: var(--color-text);
  }

  .feature-row__text {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0 0 20px;
