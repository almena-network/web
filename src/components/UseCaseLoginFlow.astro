---
import type { Lang } from "../data/landing";
import { useCaseAppLogin } from "../data/landing";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useCaseAppLogin[lang];
const f = t.flowDiagram;

// Lane x positions (App, Node, Wallet, Mesh)
const xApp = 130;
const xNode = 350;
const xWallet = 580;
const xMesh = 760;

// Step y positions
const stepY = [110, 142, 174, 206, 238, 270, 302, 334, 366, 398, 430];
---

<figure class="uc-flow">
  <figcaption class="uc-diagram__caption">
    <h3 class="uc-diagram__title">{t.sections.flow.title}</h3>
    <p class="uc-diagram__subtitle">{t.sections.flow.subtitle}</p>
  </figcaption>
  <svg
    class="uc-flow__svg"
    viewBox="0 0 840 470"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-labelledby="uc-flow-title uc-flow-desc"
  >
    <title id="uc-flow-title">{t.sections.flow.title}</title>
    <desc id="uc-flow-desc">{f.svgDesc}</desc>
    <defs>
      <marker id="uc-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
        <polygon points="0 0, 8 4, 0 8" fill="#FB923C" />
      </marker>
      <marker id="uc-arrow-soft" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
        <polygon points="0 0, 8 4, 0 8" fill="rgba(251, 146, 60, 0.55)" />
      </marker>
    </defs>

    <style>
      .uc-lane-box {
        fill: rgba(139, 92, 246, 0.12);
        stroke: rgba(139, 92, 246, 0.45);
        stroke-width: 1;
      }
      .uc-lane-box--wallet {
        fill: rgba(251, 146, 60, 0.1);
        stroke: rgba(251, 146, 60, 0.45);
      }
      .uc-lane-label {
        font-family: Inter, system-ui, -apple-system, sans-serif;
        font-size: 11px;
        font-weight: 700;
        fill: #fafafa;
      }
      .uc-lifeline {
        stroke: rgba(255, 255, 255, 0.14);
        stroke-width: 1;
        stroke-dasharray: 3 4;
      }
      .uc-arrow {
        stroke: #FB923C;
        stroke-width: 1.6;
        fill: none;
        marker-end: url(#uc-arrow);
      }
      .uc-arrow--soft {
        stroke: rgba(251, 146, 60, 0.55);
        stroke-dasharray: 5 4;
        marker-end: url(#uc-arrow-soft);
      }
      .uc-self {
        fill: none;
        stroke: #FB923C;
        stroke-width: 1.4;
        marker-end: url(#uc-arrow);
      }
      .uc-step-label {
        font-family: Inter, system-ui, -apple-system, sans-serif;
        font-size: 10.5px;
        font-weight: 500;
        fill: #d4d4d8;
      }
      .uc-step-label--muted {
        fill: #a3a3a3;
      }
    </style>

    <!-- Lane headers -->
    <rect class="uc-lane-box" x={xApp - 70} y="40" width="140" height="28" rx="6" />
    <text class="uc-lane-label" x={xApp} y="58" text-anchor="middle">{f.lanes.app}</text>

    <rect class="uc-lane-box" x={xNode - 70} y="40" width="140" height="28" rx="6" />
    <text class="uc-lane-label" x={xNode} y="58" text-anchor="middle">{f.lanes.node}</text>

    <rect class="uc-lane-box uc-lane-box--wallet" x={xWallet - 70} y="40" width="140" height="28" rx="6" />
    <text class="uc-lane-label" x={xWallet} y="58" text-anchor="middle">{f.lanes.wallet}</text>

    <rect class="uc-lane-box" x={xMesh - 60} y="40" width="120" height="28" rx="6" />
    <text class="uc-lane-label" x={xMesh} y="58" text-anchor="middle">{f.lanes.mesh}</text>

    <!-- Lifelines -->
    <line class="uc-lifeline" x1={xApp} y1="72" x2={xApp} y2="450" />
    <line class="uc-lifeline" x1={xNode} y1="72" x2={xNode} y2="450" />
    <line class="uc-lifeline" x1={xWallet} y1="72" x2={xWallet} y2="450" />
    <line class="uc-lifeline" x1={xMesh} y1="72" x2={xMesh} y2="450" />

    <!-- Step 1: App self ("User clicks Sign in with Almena") -->
    <path class="uc-self" d={`M${xApp} ${stepY[0] - 6} q 28 0 28 12 q 0 12 -28 12`} />
    <text class="uc-step-label" x={xApp + 38} y={stepY[0] + 2}>{f.steps[0]}</text>

    <!-- Step 2: App → Node (Request auth challenge) -->
    <line class="uc-arrow" x1={xApp + 4} y1={stepY[1]} x2={xNode - 6} y2={stepY[1]} />
    <text class="uc-step-label" x={(xApp + xNode) / 2} y={stepY[1] - 6} text-anchor="middle">{f.steps[1]}</text>

    <!-- Step 3: Node → App (Session id + challenge) -->
    <line class="uc-arrow" x1={xNode - 4} y1={stepY[2]} x2={xApp + 6} y2={stepY[2]} />
    <text class="uc-step-label" x={(xApp + xNode) / 2} y={stepY[2] - 6} text-anchor="middle">{f.steps[2]}</text>

    <!-- Step 4: App self (Show QR + node selector) -->
    <path class="uc-self" d={`M${xApp} ${stepY[3] - 6} q 28 0 28 12 q 0 12 -28 12`} />
    <text class="uc-step-label" x={xApp + 38} y={stepY[3] + 2}>{f.steps[3]}</text>

    <!-- Step 5: App → Wallet via camera (dashed soft, "Scan QR") -->
    <line class="uc-arrow uc-arrow--soft" x1={xApp + 4} y1={stepY[4]} x2={xWallet - 6} y2={stepY[4]} />
    <text class="uc-step-label uc-step-label--muted" x={(xApp + xWallet) / 2} y={stepY[4] - 6} text-anchor="middle">{f.steps[4]}</text>

    <!-- Step 6: Wallet self (display app + scope · biometric approval) -->
    <path class="uc-self" d={`M${xWallet} ${stepY[5] - 6} q 28 0 28 12 q 0 12 -28 12`} />
    <text class="uc-step-label" x={xWallet + 38} y={stepY[5] + 2}>{f.steps[5]}</text>

    <!-- Step 7: Wallet → Node (Sign challenge / send signed proof) -->
    <line class="uc-arrow" x1={xWallet - 4} y1={stepY[6]} x2={xNode + 6} y2={stepY[6]} />
    <text class="uc-step-label" x={(xNode + xWallet) / 2} y={stepY[6] - 6} text-anchor="middle">{f.steps[6]}</text>

    <!-- Step 8: Node → Mesh (Resolve DID document) -->
    <line class="uc-arrow" x1={xNode + 4} y1={stepY[7]} x2={xMesh - 6} y2={stepY[7]} />
    <text class="uc-step-label" x={(xNode + xMesh) / 2} y={stepY[7] - 6} text-anchor="middle">{f.steps[7]}</text>

    <!-- Step 9: Node self (verify signature) -->
    <path class="uc-self" d={`M${xNode} ${stepY[8] - 6} q 28 0 28 12 q 0 12 -28 12`} />
    <text class="uc-step-label" x={xNode + 38} y={stepY[8] + 2}>{f.steps[8]}</text>

    <!-- Step 10: Node → App (notify · session token) -->
    <line class="uc-arrow" x1={xNode - 4} y1={stepY[9]} x2={xApp + 6} y2={stepY[9]} />
    <text class="uc-step-label" x={(xApp + xNode) / 2} y={stepY[9] - 6} text-anchor="middle">{f.steps[9]}</text>

    <!-- Step 11: App self (logged in) -->
    <path class="uc-self" d={`M${xApp} ${stepY[10] - 6} q 28 0 28 12 q 0 12 -28 12`} />
    <text class="uc-step-label" x={xApp + 38} y={stepY[10] + 2}>{f.steps[10]}</text>
  </svg>
</figure>

<style>
  .uc-flow {
    margin: 0 auto 32px;
    padding: clamp(14px, 2.5vw, 22px) clamp(12px, 3vw, 24px) 16px;
    border-radius: var(--radius);
    max-width: 100%;
    background: var(--color-glass-bg);
    backdrop-filter: blur(var(--blur));
    -webkit-backdrop-filter: blur(var(--blur));
    border: 1px solid var(--color-glass-border);
  }

  .uc-diagram__caption {
    margin: 0 0 12px;
    text-align: center;
  }

  .uc-diagram__title {
    margin: 0 0 4px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .uc-diagram__subtitle {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .uc-flow__svg {
    width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
  }
</style>
