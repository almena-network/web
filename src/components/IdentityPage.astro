---
import type { Lang } from "../data/landing";
import { identity } from "../data/landing";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import IdentityDiagram from "./IdentityDiagram.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = identity[lang];
const prefix = lang === "es" ? "/es" : "";
const networkHref = `${prefix}/network/`;

const ic = (path: string) =>
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${path}</svg>`;

function roleIcon(name: string): string {
  switch (name) {
    case "issuer":
      return ic('<path d="M6 3h8l4 4v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z"/><circle cx="12" cy="12" r="2.4"/><path d="M10.2 13.8 9.5 19l2.5-1.4 2.5 1.4-.7-5.2"/>');
    case "holder":
      return ic('<circle cx="12" cy="8" r="3.4"/><path d="M5.5 20a6.5 6.5 0 0 1 13 0"/>');
    case "verifier":
      return ic('<path d="M12 3l7 3v5c0 4.6-3 7.6-7 9-4-1.4-7-4.4-7-9V6Z"/><path d="M9 12l2 2 4-4"/>');
    default:
      return ic('<circle cx="12" cy="12" r="9"/>');
  }
}

// Distinct icon per capability card, in order.
const capIcons = [
  ic('<circle cx="12" cy="8" r="3.2"/><path d="M5.5 20a6.5 6.5 0 0 1 13 0"/>'),
  ic('<path d="M6 3h9l3 3v15H6Z"/><path d="M9 8h6M9 12h6M9 16h4"/>'),
  ic('<path d="M21 12a9 9 0 1 1-3-6.7"/><polyline points="21 4 21 9 16 9"/>'),
  ic('<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><path d="M9.5 12a2.5 2.5 0 0 1 4-2"/><line x1="4" y1="4" x2="20" y2="20"/>'),
  ic('<path d="M12 3l7 3v5c0 4.6-3 7.6-7 9-4-1.4-7-4.4-7-9V6Z"/><line x1="9" y1="12" x2="15" y2="12"/>'),
  ic('<circle cx="12" cy="12" r="9"/><line x1="5" y1="5" x2="19" y2="19"/>'),
];

const check = (c: string) =>
  `<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>${c}`;
---

<SiteHeader lang={lang} page="identity" />

<main class="page">
  <!-- ── Hero ── -->
  <section class="hero">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="hero__copy">
      <span class="eyebrow">{t.hero.eyebrow}</span>
      <h1 class="hero__title">{t.hero.title}</h1>
      <p class="hero__subtitle">{t.hero.subtitle}</p>
      <div class="hero__actions">
        <a href="https://github.com/almena-network" class="btn btn--primary" target="_blank" rel="noopener">{t.hero.ctaPrimary}</a>
        <a href={networkHref} class="btn btn--ghost">{t.hero.ctaSecondary}</a>
      </div>
    </div>
    <div class="hero__visual">
      <IdentityDiagram lang={lang} />
    </div>
  </section>

  <!-- ── What ── -->
  <section class="what">
    <h2 class="what__title">{t.what.title}</h2>
    <p class="what__text">{t.what.text}</p>
    <p class="what__status">
      <span class="status-pill">{t.roadmap.label}</span>
      {t.roadmap.text}
    </p>
  </section>

  <!-- ── Roles ── -->
  <section class="roles" aria-labelledby="roles-heading">
    <div class="section-head">
      <h2 id="roles-heading" class="section-head__title">{t.teaser.title}</h2>
      <p class="section-head__subtitle">{t.note}</p>
    </div>
    <div class="roles__grid">
      {t.roles.map((r) => (
        <article class="role-card">
          <div class="role-card__icon" aria-hidden="true" set:html={roleIcon(r.key)} />
          <h3 class="role-card__title">{r.title}</h3>
          <p class="role-card__text">{r.text}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- ── Zero-knowledge / minimal disclosure ── -->
  <section class="disclosure">
    <div class="disclosure__inner">
      <div class="disclosure__body">
        <span class="disclosure__tag">{t.disclosure.tag}</span>
        <h2 class="disclosure__title">{t.disclosure.title}</h2>
        <p class="disclosure__text">{t.disclosure.text}</p>
      </div>
      <ul class="disclosure__points">
        {t.disclosure.points.map((p) => (
          <li set:html={check(p)} />
        ))}
      </ul>
    </div>
  </section>

  <!-- ── Capabilities ── -->
  <section class="caps" aria-labelledby="caps-heading">
    <div class="section-head">
      <h2 id="caps-heading" class="section-head__title">{t.capabilities.title}</h2>
    </div>
    <div class="caps__grid">
      {t.capabilities.items.map((c, i) => (
        <article class="cap-card">
          <div class="cap-card__icon" aria-hidden="true" set:html={capIcons[i]} />
          <h3 class="cap-card__title">{c.title}</h3>
          <p class="cap-card__text">{c.text}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- ── Layer note ── -->
  <section class="layer">
    <div class="layer__inner">
      <h2 class="layer__title">{t.layer.title}</h2>
      <p class="layer__text">{t.layer.text}</p>
    </div>
  </section>

  <!-- ── Final CTA ── -->
  <section class="cta">
    <div class="cta__glow" aria-hidden="true"></div>
    <div class="cta__content">
      <h2 class="cta__title">{t.cta.title}</h2>
      <p class="cta__text">{t.cta.text}</p>
      <div class="cta__actions">
        <a href="https://github.com/almena-network" class="btn btn--primary" target="_blank" rel="noopener">{t.cta.ctaPrimary}</a>
      </div>
    </div>
  </section>
</main>

<SiteFooter lang={lang} />

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 48px;
    align-items: center;
    padding: 80px 0 90px;
  }

  .hero__glow {
    position: absolute;
    top: -60px;
    left: -5%;
    width: 720px;
    height: 460px;
    max-width: 100%;
    background: radial-gradient(ellipse at center, rgba(255, 140, 0, 0.14) 0%, transparent 65%);
    pointer-events: none;
    z-index: -1;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero__title {
    font-size: clamp(2.2rem, 5vw, 3.75rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin: 22px 0;
    background: linear-gradient(170deg, #ffffff 0%, rgba(255, 255, 255, 0.72) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero__subtitle {
    font-size: clamp(1rem, 2vw, 1.1875rem);
    color: var(--color-text-muted);
    margin: 0 0 30px;
    max-width: 52ch;
    line-height: 1.65;
  }

  .hero__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* ── What ── */
  .what {
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
    padding: 0 0 90px;
  }

  .what__title {
    font-size: clamp(1.6rem, 3.2vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 0 0 18px;
    color: var(--color-text);
  }

  .what__text {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    margin: 0 0 24px;
    line-height: 1.7;
  }

  .what__status {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.6;
  }

  .status-pill {
    display: inline-block;
    margin-right: 8px;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--brand-primary);
    padding: 3px 10px;
    border-radius: 100px;
    background: var(--brand-primary-subtle);
    border: 1px solid rgba(255, 140, 0, 0.22);
    vertical-align: middle;
  }

  /* ── Roles ── */
  .roles {
    padding: 0 0 90px;
  }

  .roles__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 28px;
  }

  .role-card {
    padding: 26px;
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius);
    transition: border-color var(--transition), transform var(--transition);
  }

  .role-card:hover {
    border-color: rgba(255, 140, 0, 0.25);
    transform: translateY(-2px);
  }

  .role-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 11px;
    background: var(--brand-primary-subtle);
    color: var(--brand-primary);
    margin-bottom: 16px;
    border: 1px solid rgba(255, 140, 0, 0.16);
  }

  .role-card__title {
    font-size: 1.0625rem;
    font-weight: 600;
    margin: 0 0 8px;
    color: var(--color-text);
  }

  .role-card__text {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.55;
  }

  /* ── Disclosure ── */
  .disclosure {
    padding: 0 0 90px;
  }

  .disclosure__inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 40px;
    align-items: center;
    padding: 44px;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(ellipse 80% 100% at 0% 0%, rgba(255, 140, 0, 0.1) 0%, transparent 60%),
      var(--color-surface);
    border: 1px solid rgba(255, 140, 0, 0.18);
  }

  .disclosure__tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--brand-primary);
    margin-bottom: 12px;
  }

  .disclosure__title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 0 0 14px;
    color: var(--color-text);
  }

  .disclosure__text {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.65;
  }

  .disclosure__points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .disclosure__points li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: var(--radius);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .disclosure__points svg {
    color: var(--brand-primary);
    flex-shrink: 0;
  }

  /* ── Capabilities ── */
  .caps {
    padding: 0 0 90px;
  }

  .caps__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .cap-card {
    padding: 26px;
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius);
    transition: border-color var(--transition), transform var(--transition);
  }

  .cap-card:hover {
    border-color: rgba(255, 140, 0, 0.25);
    transform: translateY(-2px);
  }

  .cap-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 11px;
    background: var(--brand-primary-subtle);
    color: var(--brand-primary);
    margin-bottom: 16px;
    border: 1px solid rgba(255, 140, 0, 0.16);
  }

  .cap-card__title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 8px;
    color: var(--color-text);
  }

  .cap-card__text {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.55;
  }

  /* ── Layer ── */
  .layer {
    padding: 0 0 90px;
  }

  .layer__inner {
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
    padding: 40px;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .layer__title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 12px;
    color: var(--color-text);
  }

  .layer__text {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.65;
  }

  /* ── Final CTA ── */
  .cta {
    position: relative;
    overflow: hidden;
    padding: 76px 48px;
    margin: 0 0 100px;
    text-align: center;
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
  }

  .cta__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 90% at 50% 100%, rgba(255, 140, 0, 0.13) 0%, transparent 65%);
    pointer-events: none;
  }

  .cta__content {
    position: relative;
    z-index: 1;
  }

  .cta__title {
    font-size: clamp(1.6rem, 3.4vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 0 0 14px;
    color: var(--color-text);
  }

  .cta__text {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin: 0 auto 30px;
    max-width: 56ch;
    line-height: 1.65;
  }

  .cta__actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ── Responsive ── */
  @media (max-width: 960px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 36px;
      padding: 56px 0 72px;
      text-align: center;
    }

    .hero__copy {
      align-items: center;
    }

    .hero__subtitle {
      margin-inline: auto;
    }

    .hero__visual {
      order: -1;
    }

    .disclosure__inner {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  @media (max-width: 900px) {
    .roles__grid,
    .caps__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .disclosure__inner,
    .cta {
      padding: 28px 22px;
    }
  }
</style>
