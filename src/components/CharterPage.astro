---
import type { Lang } from "../data/charter";
import CharterHeader from "./CharterHeader.astro";
import CharterFooter from "./CharterFooter.astro";
import CharterHero from "./charter/CharterHero.astro";
import Countdown from "./Countdown.astro";
import SocialContract from "./charter/SocialContract.astro";
import IdentityLayer from "./charter/IdentityLayer.astro";
import ReputationGraph from "./charter/ReputationGraph.astro";
import Progression from "./charter/Progression.astro";
import Arbitration from "./charter/Arbitration.astro";
import Resilience from "./charter/Resilience.astro";
import PositiveFriction from "./charter/PositiveFriction.astro";
import FinalDeclaration from "./charter/FinalDeclaration.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<CharterHeader lang={lang} />
<main>
  <CharterHero lang={lang} />
  <Countdown lang={lang} />
  <SocialContract lang={lang} />
  <IdentityLayer lang={lang} />
  <ReputationGraph lang={lang} />
  <Progression lang={lang} />
  <Arbitration lang={lang} />
  <Resilience lang={lang} />
  <PositiveFriction lang={lang} />
  <FinalDeclaration lang={lang} />
</main>
<CharterFooter lang={lang} />
