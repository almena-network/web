---
import type { Lang } from "../data/landing";
import { landing, useCaseAppLogin } from "../data/landing";
import UseCaseLoginFlow from "./UseCaseLoginFlow.astro";
import UseCaseLoginElements from "./UseCaseLoginElements.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useCaseAppLogin[lang];
const home = landing[lang];

const homeHref = lang === "en" ? "/" : "/es/";
const otherHref = lang === "en" ? "/es/use-cases/app-login/" : "/use-cases/app-login/";
---

<div class="uc-page">
<header class="landing-header">
  <a href={homeHref} class="landing-logo" aria-label="Almena Network">
    <img src="/logo.svg" alt="" width="36" height="36" />
    <span>Almena Network</span>
  </a>
  <a href={otherHref} class="landing-lang">{home.langSwitch}</a>
</header>

<main class="uc-main">
  <a class="uc-back" href={homeHref}>
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M11 3L6 8l5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    {t.backToHome}
  </a>

  <section class="uc-hero">
    <p class="uc-eyebrow">{t.eyebrow}</p>
    <h1 class="uc-title">{t.title}</h1>
    <p class="uc-description">{t.description}</p>
  </section>

  <section class="uc-section" aria-labelledby="uc-problem">
    <h2 id="uc-problem" class="uc-section-title">{t.sections.problem.title}</h2>
    <p class="uc-section-text">{t.sections.problem.text}</p>
  </section>

  <section class="uc-section" aria-labelledby="uc-experience">
    <h2 id="uc-experience" class="uc-section-title">{t.sections.experience.title}</h2>
    <ol class="uc-steps">
      {t.sections.experience.steps.map((step) => (
        <li class="uc-step landing-glass">
          <h3 class="uc-step__title">{step.title}</h3>
          <p class="uc-step__text">{step.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <UseCaseLoginFlow lang={lang} />

  <UseCaseLoginElements lang={lang} />

  <section class="uc-section" aria-labelledby="uc-security">
    <h2 id="uc-security" class="uc-section-title">{t.sections.security.title}</h2>
    <ul class="uc-bullets">
      {t.sections.security.items.map((item) => <li>{item}</li>)}
    </ul>
  </section>
</main>

<footer class="landing-footer">
  <p>
    Almena Network {home.footer.tagline} · {new Date().getFullYear()}
    · <a href={`mailto:${home.footer.email}`} class="landing-footer__link">{home.footer.email}</a>
  </p>
</footer>
</div>

<style>
  /* Centered shell: scales with viewport, generous gutters on ultrawide */
  .uc-page {
    box-sizing: border-box;
    width: min(1280px, 100%);
    margin: 0 auto;
    padding-left: clamp(14px, 4vw, 40px);
    padding-right: clamp(14px, 4vw, 40px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  .landing-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 0;
    padding-top: max(12px, env(safe-area-inset-top));
  }

  .landing-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-text);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.15rem;
  }

  .landing-logo img {
    width: 32px;
    height: 32px;
  }

  .landing-logo:hover {
    color: var(--color-primary);
  }

  .landing-lang {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.875rem;
    padding: 6px 14px;
    border-radius: var(--radius-sm);
    transition: color var(--transition), background var(--transition);
  }

  .landing-lang:hover {
    color: var(--color-primary);
    background: var(--color-glass-bg);
  }

  .uc-main {
    padding: 24px 0 48px;
  }

  .uc-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.875rem;
    margin-bottom: 16px;
    transition: color var(--transition), gap var(--transition);
  }

  .uc-back:hover {
    color: var(--color-primary);
    gap: 10px;
  }

  .uc-hero {
    margin-bottom: 32px;
    text-align: center;
    max-width: min(90ch, 100%);
    margin-inline: auto;
  }

  .uc-eyebrow {
    margin: 0 0 8px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-secondary);
  }

  .uc-title {
    margin: 0 0 12px;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.15;
    background: linear-gradient(135deg, var(--color-text) 0%, var(--color-text-muted) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .uc-description {
    margin: 0 auto;
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: min(85ch, 100%);
    text-wrap: balance;
  }

  .uc-section {
    margin-bottom: 32px;
  }

  .uc-section-title {
    margin: 0 auto 12px;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-primary);
    max-width: min(90ch, 100%);
    text-align: center;
  }

  .uc-section-text {
    margin: 0 auto;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: min(82ch, 100%);
    text-align: left;
  }

  .uc-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(10px, 2vw, 16px);
  }

  .landing-glass {
    background: var(--color-glass-bg);
    backdrop-filter: blur(var(--blur));
    -webkit-backdrop-filter: blur(var(--blur));
    border: 1px solid var(--color-glass-border);
  }

  .uc-step {
    padding: 16px;
    border-radius: var(--radius);
  }

  .uc-step__title {
    margin: 0 0 6px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-secondary);
  }

  .uc-step__text {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .uc-bullets {
    margin: 0 auto;
    padding-left: 20px;
    color: var(--color-text-muted);
    max-width: min(82ch, 100%);
    text-align: left;
    box-sizing: border-box;
  }

  .uc-bullets li {
    margin: 0 0 8px;
    font-size: 0.9375rem;
    line-height: 1.55;
    padding-right: env(safe-area-inset-right, 0px);
  }

  .landing-footer {
    text-align: center;
    padding: 20px 0;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  .landing-footer p {
    margin: 0;
  }

  .landing-footer__link {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition);
  }

  .landing-footer__link:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  @media screen and (max-width: 1100px) {
    .uc-steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 840px) {
    .uc-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 640px) {
    .uc-main {
      padding: 16px 0 40px;
    }

    .uc-steps {
      grid-template-columns: minmax(0, 1fr);
    }

    .uc-section-title {
      text-align: left;
      margin-left: 0;
      margin-right: 0;
    }

    .uc-section-text {
      margin-left: 0;
      margin-right: 0;
    }

    .uc-bullets {
      margin-left: 0;
      margin-right: 0;
    }

    .uc-hero {
      text-align: left;
      margin-inline: 0;
    }

    .uc-description {
      margin-left: 0;
      margin-right: 0;
    }
  }
</style>
