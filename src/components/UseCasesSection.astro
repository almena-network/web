---
import type { Lang } from "../data/landing";
import { landing } from "../data/landing";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = landing[lang].useCases;
---

<section class="landing-usecases" aria-labelledby="usecases-heading">
  <h2 id="usecases-heading" class="landing-section-title">{t.title}</h2>
  <p class="landing-section-subtitle">{t.subtitle}</p>
  <div class="landing-usecases-grid">
    {t.items.map((item) => (
      <a class="landing-usecase landing-glass" href={item.href}>
        <h3 class="landing-usecase__title">{item.title}</h3>
        <p class="landing-usecase__text">{item.summary}</p>
        <ul class="landing-usecase__tags" aria-hidden="true">
          {item.tags.map((tag) => <li>{tag}</li>)}
        </ul>
        <span class="landing-usecase__cta" aria-hidden="true">
          {t.readMore}
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M5 3l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </a>
    ))}
  </div>
</section>

<style>
  .landing-usecases {
    margin-bottom: 40px;
  }

  .landing-usecases-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .landing-glass {
    background: var(--color-glass-bg);
    backdrop-filter: blur(var(--blur));
    -webkit-backdrop-filter: blur(var(--blur));
    border: 1px solid var(--color-glass-border);
  }

  .landing-usecase {
    display: flex;
    flex-direction: column;
    padding: 20px;
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--color-text);
    transition: border-color var(--transition), transform var(--transition);
  }

  .landing-usecase:hover,
  .landing-usecase:focus-visible {
    border-color: rgba(251, 146, 60, 0.35);
    transform: translateY(-2px);
    outline: none;
  }

  .landing-usecase__title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 8px;
    color: var(--color-primary);
  }

  .landing-usecase__text {
    flex: 1;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin: 0 0 12px;
    line-height: 1.5;
  }

  .landing-usecase__tags {
    list-style: none;
    padding: 0;
    margin: 0 0 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .landing-usecase__tags li {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    background: rgba(255, 255, 255, 0.04);
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .landing-usecase__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-primary);
    transition: gap var(--transition);
  }

  .landing-usecase:hover .landing-usecase__cta,
  .landing-usecase:focus-visible .landing-usecase__cta {
    gap: 10px;
  }

  @media screen and (max-width: 996px) {
    .landing-usecases-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 640px) {
    .landing-usecases-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
