---
import type { Lang } from "../data/landing";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const c = {
  en: {
    you: "You",
    entry: "Entry",
    relay: "Relay",
    exit: "Exit",
    recipient: "Recipient",
    entryNote: "Sees you, not the destination",
    exitNote: "Sees the destination, not you",
    caption: "Every message is wrapped in three layers of encryption and peeled one hop at a time. No node ever sees both ends.",
  },
  es: {
    you: "Tú",
    entry: "Entrada",
    relay: "Relevo",
    exit: "Salida",
    recipient: "Destinatario",
    entryNote: "Te ve a ti, no el destino",
    exitNote: "Ve el destino, no a ti",
    caption: "Cada mensaje se envuelve en tres capas de cifrado y se pela salto a salto. Ningún nodo ve nunca los dos extremos.",
  },
}[lang];
---

<figure class="onion">
  <svg
    class="onion__svg"
    viewBox="0 0 880 220"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label={c.caption}
  >
    <defs>
      <marker id="onion-arr" markerWidth="7" markerHeight="7" refX="5.5" refY="3" orient="auto">
        <polygon points="0 0, 7 3, 0 6" fill="#FF8C00" />
      </marker>
    </defs>

    <style>
      .o-endpoint { fill: rgba(255, 140, 0, 0.1); stroke: #FF8C00; stroke-width: 1.6; }
      .o-node { fill: rgba(255, 255, 255, 0.04); stroke: rgba(255, 255, 255, 0.22); stroke-width: 1.4; }
      .o-node-glow { fill: rgba(255, 140, 0, 0.04); stroke: rgba(255, 140, 0, 0.45); stroke-width: 1.4; }
      .o-line { stroke: #FF8C00; stroke-width: 2; fill: none; stroke-dasharray: 6 5; marker-end: url(#onion-arr); }
      .o-lbl { font-family: Inter, system-ui, sans-serif; font-size: 13px; font-weight: 600; fill: #f0f0f0; }
      .o-lbl-node { font-family: Inter, system-ui, sans-serif; font-size: 12px; font-weight: 600; fill: #f0f0f0; }
      .o-sub { font-family: Inter, system-ui, sans-serif; font-size: 10.5px; font-weight: 500; fill: #888; }
      .o-layer { font-family: Inter, system-ui, sans-serif; font-size: 16px; font-weight: 700; fill: #FF8C00; }
    </style>

    <!-- path lines -->
    <line class="o-line" x1="118" y1="110" x2="244" y2="110" />
    <line class="o-line" x1="316" y1="110" x2="436" y2="110" />
    <line class="o-line" x1="508" y1="110" x2="628" y2="110" />
    <line class="o-line" x1="700" y1="110" x2="820" y2="110" />

    <!-- You -->
    <circle class="o-endpoint" cx="60" cy="110" r="40" />
    <text class="o-lbl" x="60" y="115" text-anchor="middle">{c.you}</text>
    <text class="o-layer" x="60" y="172" text-anchor="middle">🧅×3</text>

    <!-- Entry -->
    <circle class="o-node-glow" cx="280" cy="110" r="34" />
    <text class="o-lbl-node" x="280" y="115" text-anchor="middle">{c.entry}</text>
    <text class="o-sub" x="280" y="170" text-anchor="middle">{c.entryNote}</text>

    <!-- Relay -->
    <circle class="o-node" cx="472" cy="110" r="34" />
    <text class="o-lbl-node" x="472" y="115" text-anchor="middle">{c.relay}</text>

    <!-- Exit -->
    <circle class="o-node-glow" cx="664" cy="110" r="34" />
    <text class="o-lbl-node" x="664" y="115" text-anchor="middle">{c.exit}</text>
    <text class="o-sub" x="664" y="170" text-anchor="middle">{c.exitNote}</text>

    <!-- Recipient -->
    <circle class="o-endpoint" cx="840" cy="110" r="40" />
    <text class="o-lbl" x="840" y="106" text-anchor="middle">{c.recipient}</text>
  </svg>
  <figcaption class="onion__caption">{c.caption}</figcaption>
</figure>

<style>
  .onion {
    margin: 0;
    padding: 28px 24px 24px;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .onion__svg {
    width: 100%;
    max-width: 880px;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  .onion__caption {
    margin: 16px auto 0;
    max-width: 60ch;
    text-align: center;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.55;
  }
</style>
