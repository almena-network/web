---
import type { Lang } from "../../data/charter";
import { charter } from "../../data/charter";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = charter[lang].resilience;
const r = t.rotation;
---

<section id="resilience" class="section section--alt">
  <div class="page">
    <div class="sec-head sec-head--center">
      <span class="sec-num">{t.num}</span>
      <span class="sec-kicker">{t.kicker}</span>
      <h2 class="sec-title">{t.title}</h2>
    </div>

    <div class="res">
      <article class="res__card">
        <span class="card__tag">{t.cards[0].tag}</span>
        <h3 class="card__title">{t.cards[0].title}</h3>
        <p class="card__text">{t.cards[0].text}</p>

        <div class="res__rot" aria-hidden="true">
          <span class="res__alias res__alias--old">{r.from}</span>
          <span class="res__rot-arrow">↻</span>
          <span class="res__alias res__alias--new">{r.to}</span>
          <div class="res__persist">
            <span class="res__persist-dot"></span>{r.persist}
          </div>
        </div>
      </article>

      <article class="res__card res__card--soon">
        <span class="card__tag card__tag--soon">{t.cards[1].tag}</span>
        <h3 class="card__title">{t.cards[1].title}</h3>
        <p class="card__text">{t.cards[1].text}</p>

        <div class="res__bridge" aria-hidden="true">
          <span class="res__bridge-node">Almena</span>
          <span class="res__bridge-line"></span>
          <span class="res__bridge-badge">⇄</span>
          <span class="res__bridge-line"></span>
          <span class="res__bridge-node res__bridge-node--ext">↔ ext.</span>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .res {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    max-width: 960px;
    margin: 0 auto;
  }

  .res__card {
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: var(--radius-lg);
    padding: 26px;
    display: flex;
    flex-direction: column;
  }

  .res__card--soon {
    border-style: dashed;
    border-color: rgba(255, 255, 255, 0.16);
  }

  .card__tag--soon {
    color: var(--color-text-muted);
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.14);
  }

  .res__rot {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: auto;
    padding-top: 22px;
  }

  .res__alias {
    font-size: 0.8125rem;
    font-weight: 700;
    padding: 8px 14px;
    border-radius: 8px;
  }

  .res__alias--old {
    color: var(--color-text-subtle);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    text-decoration: line-through;
  }

  .res__alias--new {
    color: #0d0d0d;
    background: var(--brand-primary);
  }

  .res__rot-arrow {
    font-size: 1.25rem;
    color: var(--brand-primary);
  }

  .res__persist {
    flex-basis: 100%;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .res__persist-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--brand-primary);
    flex-shrink: 0;
  }

  .res__bridge {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 22px;
  }

  .res__bridge-node {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--brand-primary);
    background: var(--brand-primary-subtle);
    border: 1px solid rgba(255, 140, 0, 0.28);
    padding: 8px 14px;
    border-radius: 8px;
    white-space: nowrap;
  }

  .res__bridge-node--ext {
    color: var(--color-text-muted);
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.12);
  }

  .res__bridge-line {
    flex: 1;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--brand-primary) 0 6px, transparent 6px 11px);
    opacity: 0.6;
  }

  .res__bridge-badge {
    color: var(--brand-primary);
    font-size: 1.1rem;
  }

  @media (max-width: 760px) {
    .res { grid-template-columns: 1fr; }
  }
</style>
