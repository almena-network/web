---
import type { Lang } from "../../data/charter";
import { charter } from "../../data/charter";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = charter[lang].friction;
---

<section id="friction" class="section">
  <div class="page">
    <div class="sec-head sec-head--center">
      <span class="sec-num">{t.num}</span>
      <span class="sec-kicker">{t.kicker}</span>
      <h2 class="sec-title">{t.title}</h2>
      <p class="sec-lead">{t.lead}</p>
    </div>

    <div class="fric">
      <div class="fric__flow">
        {t.flow.map((f, i) => (
          <>
            <div class={`fric__node fric__node--${i}`}>
              <span class="fric__node-label">{f.label}</span>
              <p class="fric__node-text">{f.text}</p>
            </div>
            {i < t.flow.length - 1 && <span class="fric__sep" aria-hidden="true">→</span>}
          </>
        ))}
      </div>

      <p class="fric__text">{t.text}</p>
    </div>
  </div>
</section>

<style>
  .fric {
    max-width: 960px;
    margin: 0 auto;
  }

  .fric__flow {
    display: flex;
    align-items: stretch;
    gap: 10px;
  }

  .fric__node {
    flex: 1;
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: var(--radius-lg);
    padding: 22px 20px;
  }

  .fric__node--1 {
    border-color: rgba(245, 166, 35, 0.4);
    background: linear-gradient(180deg, rgba(245, 166, 35, 0.06), var(--color-surface));
  }

  .fric__node--2 {
    border-color: rgba(255, 140, 0, 0.4);
    background: linear-gradient(180deg, var(--brand-primary-subtle), var(--color-surface));
  }

  .fric__node-label {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-subtle);
    margin-bottom: 10px;
  }

  .fric__node--1 .fric__node-label { color: var(--semantic-warning); }
  .fric__node--2 .fric__node-label { color: var(--brand-primary); }

  .fric__node-text {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-text);
  }

  .fric__sep {
    align-self: center;
    color: var(--brand-primary);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .fric__text {
    margin: 28px auto 0;
    max-width: 68ch;
    text-align: center;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  @media (max-width: 760px) {
    .fric__flow { flex-direction: column; }
    .fric__sep { transform: rotate(90deg); align-self: center; }
  }
</style>
