---
import type { Lang } from "../../data/charter";
import { charter } from "../../data/charter";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = charter[lang].contract;
---

<section id="contract" class="section section--alt">
  <div class="page">
    <div class="sec-head sec-head--center">
      <span class="sec-num">{t.num}</span>
      <span class="sec-kicker">{t.kicker}</span>
      <h2 class="sec-title">{t.title}</h2>
      <p class="sec-lead">{t.lead}</p>
    </div>

    <div class="contract">
      <article class="contract__pillar">
        <div class="contract__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z" />
            <path d="M9.2 12l1.9 1.9L15 10" />
          </svg>
        </div>
        <span class="card__tag">{t.pillars[0].tag}</span>
        <h3 class="card__title">{t.pillars[0].title}</h3>
        <p class="card__text">{t.pillars[0].text}</p>
      </article>

      <div class="contract__joiner" aria-hidden="true">
        <span class="contract__amp">&amp;</span>
        <span class="contract__joiner-label">{t.joiner}</span>
      </div>

      <article class="contract__pillar">
        <div class="contract__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10.5 13.5a3.5 3.5 0 0 0 5 0l2.5-2.5a3.54 3.54 0 0 0-5-5l-1.4 1.4" />
            <path d="M13.5 10.5a3.5 3.5 0 0 0-5 0L6 13a3.54 3.54 0 0 0 5 5l1.4-1.4" />
          </svg>
        </div>
        <span class="card__tag">{t.pillars[1].tag}</span>
        <h3 class="card__title">{t.pillars[1].title}</h3>
        <p class="card__text">{t.pillars[1].text}</p>
      </article>
    </div>
  </div>
</section>

<style>
  .contract {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    gap: 20px;
    max-width: 900px;
    margin: 0 auto;
  }

  .contract__pillar {
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: var(--radius-lg);
    padding: 28px 26px;
  }

  .contract__icon {
    width: 46px;
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    color: var(--brand-primary);
    background: var(--brand-primary-subtle);
    border: 1px solid rgba(255, 140, 0, 0.24);
    margin-bottom: 16px;
  }

  .contract__icon svg {
    width: 24px;
    height: 24px;
  }

  .contract__joiner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .contract__amp {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-size: 1.25rem;
    font-weight: 700;
    color: #0d0d0d;
    background: var(--brand-primary);
  }

  .contract__joiner-label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-subtle);
  }

  @media (max-width: 760px) {
    .contract {
      grid-template-columns: 1fr;
    }

    .contract__joiner {
      flex-direction: row;
      gap: 12px;
    }
  }
</style>
