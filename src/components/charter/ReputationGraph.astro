---
import type { Lang } from "../../data/charter";
import { charter } from "../../data/charter";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = charter[lang].reputation;
const d = t.diagram;
---

<section id="reputation" class="section section--alt">
  <div class="page">
    <div class="sec-head sec-head--center">
      <span class="sec-num">{t.num}</span>
      <span class="sec-kicker">{t.kicker}</span>
      <h2 class="sec-title">{t.title}</h2>
      <p class="sec-lead">{t.lead}</p>
    </div>

    <figure class="rep__fig">
      <svg viewBox="0 0 760 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={d.caption}>
        <defs>
          <radialGradient id="rep-subject" cx="50%" cy="40%" r="70%">
            <stop offset="0%" stop-color="rgba(255,140,0,0.35)" />
            <stop offset="100%" stop-color="rgba(255,140,0,0.08)" />
          </radialGradient>
        </defs>

        <!-- healthy edges (diverse validators → subject) -->
        <g stroke="var(--brand-primary)" stroke-width="2.2" fill="none" opacity="0.85">
          <line x1="210" y1="180" x2="70" y2="70" />
          <line x1="210" y1="180" x2="40" y2="180" />
          <line x1="210" y1="180" x2="70" y2="292" />
          <line x1="210" y1="180" x2="200" y2="44" />
          <line x1="210" y1="180" x2="200" y2="316" />
        </g>

        <!-- diverse validator nodes -->
        <g class="rep-good">
          <circle cx="70" cy="70" r="17" /><circle cx="40" cy="180" r="17" />
          <circle cx="70" cy="292" r="17" /><circle cx="200" cy="44" r="15" />
          <circle cx="200" cy="316" r="15" />
        </g>

        <!-- subject -->
        <circle cx="210" cy="180" r="46" fill="url(#rep-subject)" stroke="var(--brand-primary)" stroke-width="2" />
        <text x="210" y="186" text-anchor="middle" class="rep-subject-lbl">{d.subject}</text>

        <!-- divider -->
        <line x1="400" y1="40" x2="400" y2="320" stroke="rgba(255,255,255,0.1)" stroke-width="1" stroke-dasharray="4 6" />

        <!-- collusion bubble -->
        <ellipse cx="580" cy="180" rx="140" ry="120" fill="rgba(255,255,255,0.02)" stroke="rgba(245,166,35,0.5)" stroke-width="1.6" stroke-dasharray="7 6" />
        <!-- closed mutual-support edges -->
        <g stroke="#6a6a6a" stroke-width="1.8" fill="none" opacity="0.8">
          <line x1="520" y1="120" x2="640" y2="120" />
          <line x1="640" y1="120" x2="640" y2="240" />
          <line x1="640" y1="240" x2="520" y2="240" />
          <line x1="520" y1="240" x2="520" y2="120" />
          <line x1="520" y1="120" x2="640" y2="240" />
          <line x1="640" y1="120" x2="520" y2="240" />
        </g>
        <g class="rep-bad">
          <circle cx="520" cy="120" r="16" /><circle cx="640" cy="120" r="16" />
          <circle cx="520" cy="240" r="16" /><circle cx="640" cy="240" r="16" />
        </g>
        <!-- penalty badge -->
        <g>
          <circle cx="580" cy="180" r="20" fill="rgba(245,166,35,0.14)" stroke="var(--semantic-warning)" stroke-width="1.6" />
          <path d="M572 172 L588 188 M588 172 L572 188" stroke="var(--semantic-warning)" stroke-width="2.4" stroke-linecap="round" />
        </g>

        <!-- labels -->
        <text x="140" y="346" text-anchor="middle" class="rep-cap-good">✓ {d.diverse}</text>
        <text x="580" y="346" text-anchor="middle" class="rep-cap-bad">✕ {d.collusion}</text>
      </svg>

      <div class="rep__legend">
        <p class="rep__legend-item rep__legend-item--good">{d.diverseNote}</p>
        <p class="rep__legend-item rep__legend-item--bad">{d.collusionNote}</p>
      </div>
      <figcaption class="rep__cap">{d.caption}</figcaption>
    </figure>

    <div class="rep__points">
      {t.points.map((p, i) => (
        <div class="rep__point">
          <span class="rep__point-n">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="card__title">{p.title}</h3>
          <p class="card__text">{p.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .rep__fig {
    margin: 0 auto;
    max-width: 820px;
    padding: 22px 20px 18px;
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
  }

  .rep__fig svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .rep-good circle { fill: rgba(255, 140, 0, 0.16); stroke: var(--brand-primary); stroke-width: 1.8; }
  .rep-bad circle { fill: rgba(255, 255, 255, 0.03); stroke: #6a6a6a; stroke-width: 1.6; }
  .rep-subject-lbl { font-family: Inter, system-ui, sans-serif; font-size: 15px; font-weight: 700; fill: #fff; }
  .rep-cap-good { font-family: Inter, system-ui, sans-serif; font-size: 12.5px; font-weight: 700; fill: var(--brand-primary); }
  .rep-cap-bad { font-family: Inter, system-ui, sans-serif; font-size: 12.5px; font-weight: 700; fill: var(--semantic-warning); }

  .rep__legend {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin: 14px 0 0;
  }

  .rep__legend-item {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    padding-left: 14px;
    border-left: 2px solid;
  }

  .rep__legend-item--good { border-color: var(--brand-primary); }
  .rep__legend-item--bad { border-color: var(--semantic-warning); }

  .rep__cap {
    margin: 16px auto 0;
    max-width: 64ch;
    text-align: center;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .rep__points {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin: 40px 0 0;
  }

  .rep__point {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: var(--radius);
    padding: 22px 20px;
  }

  .rep__point-n {
    display: block;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--brand-primary);
    margin-bottom: 10px;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 760px) {
    .rep__legend { grid-template-columns: 1fr; gap: 8px; }
    .rep__points { grid-template-columns: 1fr; }
  }
</style>
