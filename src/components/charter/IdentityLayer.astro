---
import type { Lang } from "../../data/charter";
import { charter } from "../../data/charter";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = charter[lang].identity;
---

<section id="identity" class="section">
  <div class="page identity">
    <div class="identity__copy">
      <span class="sec-num">{t.num}</span>
      <span class="sec-kicker">{t.kicker}</span>
      <h2 class="sec-title">{t.title}</h2>
      <p class="sec-lead">{t.lead}</p>

      <ul class="identity__list">
        <li>
          <strong>{t.holder.title}.</strong> {t.holder.text}
        </li>
        <li>
          <strong>{t.issuer.title}.</strong> {t.issuer.text}
        </li>
        <li>
          <strong>{t.verifier.title}.</strong> {t.verifier.text}
        </li>
        <li class="identity__list-hi">
          <strong>{t.circular.title}.</strong> {t.circular.text}
        </li>
      </ul>
    </div>

    <figure class="identity__fig">
      <svg viewBox="0 0 340 300" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={t.circular.text}>
        <defs>
          <marker id="id-arr" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
            <polygon points="0 0, 7 3, 0 6" fill="var(--brand-primary)" />
          </marker>
          <marker id="id-arr-muted" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
            <polygon points="0 0, 7 3, 0 6" fill="#8a8a8a" />
          </marker>
        </defs>

        <!-- SSI flow: Issuer → Holder → Verifier -->
        <line x1="98" y1="86" x2="146" y2="188" stroke="var(--brand-primary)" stroke-width="2"
          stroke-dasharray="6 5" marker-end="url(#id-arr)" />
        <line x1="194" y1="188" x2="242" y2="86" stroke="var(--brand-primary)" stroke-width="2"
          stroke-dasharray="6 5" marker-end="url(#id-arr)" />

        <!-- circular governance: Holders grant reputation to Issuers & Verifiers -->
        <path d="M150 232 Q 70 250 74 96" fill="none" stroke="#8a8a8a" stroke-width="1.8"
          stroke-dasharray="5 5" marker-end="url(#id-arr-muted)" />
        <path d="M190 232 Q 270 250 266 96" fill="none" stroke="#8a8a8a" stroke-width="1.8"
          stroke-dasharray="5 5" marker-end="url(#id-arr-muted)" />

        <!-- Issuer node (top-left) -->
        <circle cx="74" cy="72" r="38" fill="rgba(255,140,0,0.08)" stroke="var(--brand-primary)" stroke-width="1.6" />
        <text x="74" y="70" text-anchor="middle" class="id-node">{t.issuer.title.split(" ")[0]}</text>
        <text x="74" y="86" text-anchor="middle" class="id-sub">Issuer</text>

        <!-- Verifier node (top-right) -->
        <circle cx="266" cy="72" r="38" fill="rgba(255,140,0,0.08)" stroke="var(--brand-primary)" stroke-width="1.6" />
        <text x="266" y="70" text-anchor="middle" class="id-node">{t.verifier.title.split(" ")[0]}</text>
        <text x="266" y="86" text-anchor="middle" class="id-sub">Verifier</text>

        <!-- Holder node (bottom-center) -->
        <circle cx="170" cy="212" r="40" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.28)" stroke-width="1.6" />
        <text x="170" y="210" text-anchor="middle" class="id-node">{t.holder.title.split(" ")[0]}</text>
        <text x="170" y="226" text-anchor="middle" class="id-sub">Holder</text>

        <!-- edge labels -->
        <text x="96" y="150" text-anchor="middle" class="id-edge">{t.edgeIssues}</text>
        <text x="244" y="150" text-anchor="middle" class="id-edge">{t.edgePresents}</text>
        <text x="170" y="286" text-anchor="middle" class="id-edge id-edge--muted">↺ {t.edgeGrants}</text>
      </svg>
      <figcaption class="identity__cap">{t.circular.title}</figcaption>
    </figure>
  </div>
</section>

<style>
  .identity {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
  }

  .identity__list {
    list-style: none;
    padding: 0;
    margin: 26px 0 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .identity__list li {
    position: relative;
    padding-left: 20px;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .identity__list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 9px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
  }

  .identity__list strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .identity__list-hi::before {
    background: var(--brand-primary) !important;
  }

  .identity__fig {
    margin: 0;
    padding: 24px 16px 18px;
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
  }

  .identity__fig svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .id-node { font-family: Inter, system-ui, sans-serif; font-size: 13px; font-weight: 700; fill: #f0f0f0; }
  .id-sub { font-family: Inter, system-ui, sans-serif; font-size: 9.5px; font-weight: 500; fill: #888; text-transform: uppercase; letter-spacing: 0.06em; }
  .id-edge { font-family: Inter, system-ui, sans-serif; font-size: 11.5px; font-weight: 600; fill: var(--brand-primary); }
  .id-edge--muted { fill: #9a9a9a; }

  .identity__cap {
    margin: 12px 0 0;
    text-align: center;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  @media (max-width: 820px) {
    .identity {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .identity__fig {
      max-width: 380px;
      margin: 0 auto;
    }
  }
</style>
