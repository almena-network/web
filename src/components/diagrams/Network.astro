---
/**
 * Why an open network of strangers can still be trusted.
 *
 * The picture makes one point: every answer carries the signature of whoever had the right to
 * make it, so the node that hands it over is a **messenger** rather than an authority. Whoever
 * receives it checks the signature themselves, which is why it does not matter who served it —
 * and why a hostile node can refuse but cannot lie.
 *
 * There is no cluster of validators here, and that absence is the point: nothing in the picture
 * decides anything on anybody's behalf.
 *
 * The hostile node is the only thing on the page drawn in the refusal colour, and it is drawn
 * the same size as the others. It is not a threat to the network; it is an ordinary participant
 * whose worst available move is silence.
 */

interface Props {
  /** What a screen reader is told the picture shows. */
  label: string;
  /** What an ordinary node is called. */
  node: string;
  /** What the hostile node is called. */
  hostile: string;
  /** What the person checking is called. */
  reader: string;
  /** The two captions: what travels, and what the hostile one can do. */
  captions: readonly [string, string];
  /** The line under the picture. */
  caption: string;
}

const { label, node, hostile, reader, captions, caption } = Astro.props;
---

<figure class="panel">
  <div class="panel__frame">
    <svg viewBox="0 0 720 312" role="img" aria-label={label}>
      <defs>
        <marker
          id="net-head"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="7"
          markerHeight="7"
          orient="auto-start-reverse"
        >
          <path d="M0 0 L10 5 L0 10 z" fill="var(--brand)"></path>
        </marker>
        <marker
          id="net-head-bad"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="7"
          markerHeight="7"
          orient="auto-start-reverse"
        >
          <path d="M0 0 L10 5 L0 10 z" fill="var(--tone-bad)"></path>
        </marker>
        <radialGradient id="net-reader" cx="50%" cy="50%" r="70%">
          <stop offset="0%" stop-color="rgba(235, 114, 41, 0.22)"></stop>
          <stop offset="100%" stop-color="rgba(235, 114, 41, 0.06)"></stop>
        </radialGradient>
      </defs>

      <!-- The mesh: everybody talks to everybody, nobody decides. Drawn first, so the nodes sit
           on top of it rather than being crossed by it. -->
      <g class="mesh">
        <path d="M110 72 L290 48"></path>
        <path d="M290 48 L470 72"></path>
        <path d="M110 72 L290 176"></path>
        <path d="M470 72 L290 176"></path>
        <path d="M290 48 L290 176"></path>
      </g>

      <!-- A handful of nodes, none of them special. -->
      <g class="nodes">
        <circle cx="110" cy="72" r="36"></circle>
        <text class="dia-label" x="110" y="77">{node}</text>
        <circle cx="290" cy="48" r="36"></circle>
        <text class="dia-label" x="290" y="53">{node}</text>
        <circle cx="470" cy="72" r="36"></circle>
        <text class="dia-label" x="470" y="77">{node}</text>
      </g>

      <g class="nodes nodes--hostile">
        <circle cx="290" cy="176" r="36"></circle>
        <text class="dia-label" x="290" y="181">{hostile}</text>
      </g>

      <!-- What reaches the reader is signed by its author, whoever passed it on. -->
      <g class="served">
        <path d="M470 108 L556 198" marker-end="url(#net-head)"></path>
        <text class="dia-note" x="596" y="146">{captions[0]}</text>
      </g>
      <g class="refused">
        <path d="M326 186 L482 226" marker-end="url(#net-head-bad)"></path>
        <text class="dia-note refused__label" x="300" y="300"
          >{captions[1]}</text
        >
      </g>

      <g class="reader">
        <rect x="486" y="198" width="204" height="72" rx="18"></rect>
        <text class="dia-title" x="588" y="240">{reader}</text>
      </g>
    </svg>
  </div>

  <figcaption>{caption}</figcaption>
</figure>

<style>
  .nodes circle {
    fill: var(--tone-net-wash);
    stroke: var(--tone-net-edge);
    stroke-width: 1.5;
  }

  .nodes .dia-label {
    fill: var(--tone-net);
    font-weight: 600;
  }

  .nodes--hostile circle {
    fill: var(--tone-bad-wash);
    stroke: var(--tone-bad-edge);
    stroke-width: 1.5;
    stroke-dasharray: 6 5;
  }

  .nodes--hostile .dia-label {
    fill: var(--tone-bad);
  }

  .mesh path {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1;
  }

  .reader rect {
    fill: url(#net-reader);
    stroke: var(--brand);
    stroke-width: 1.5;
  }

  .reader .dia-title {
    fill: var(--brand-bright);
  }

  .served path {
    fill: none;
    stroke: var(--brand);
    stroke-width: 2.5;
  }

  .refused path {
    fill: none;
    stroke: var(--tone-bad);
    stroke-width: 1.8;
    stroke-dasharray: 6 5;
  }

  .refused__label {
    fill: var(--tone-bad);
    text-anchor: start;
  }
</style>
