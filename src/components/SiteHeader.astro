---
import type { Lang } from "../data/landing";
import { site, launchLabel } from "../data/landing";

interface Props {
  lang: Lang;
  page: "home" | "network" | "coin";
}

const { lang, page } = Astro.props;
const t = site[lang].nav;

const prefix = lang === "es" ? "/es" : "";
const homeHref = lang === "es" ? "/es/" : "/";
const networkHref = `${prefix}/network/`;
const coinHref = `${prefix}/coin/`;

// Language switch keeps the user on the equivalent page.
const otherPrefix = lang === "en" ? "/es" : "";
const otherLangHref =
  page === "network"
    ? `${otherPrefix}/network/`
    : page === "coin"
      ? `${otherPrefix}/coin/`
      : lang === "en"
        ? "/es/"
        : "/";

const launchTag = launchLabel(lang);
---

<header class="nav">
  <div class="nav__inner">
    <a href={homeHref} class="nav__logo" aria-label="Almena">
      <img src="/logo.svg" alt="" width="30" height="30" />
      <span>Almena</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      <a href={homeHref} class={`nav__link${page === "home" ? " nav__link--active" : ""}`}>{t.messenger}</a>
      <a href={networkHref} class={`nav__link${page === "network" ? " nav__link--active" : ""}`}>{t.network}</a>
      <a href={coinHref} class={`nav__link${page === "coin" ? " nav__link--active" : ""}`}>{t.coin}</a>
      <a href="https://docs.almena.network" class="nav__link" target="_blank" rel="noopener">{t.docs}</a>
      <a href="https://github.com/almena-network" class="nav__link" target="_blank" rel="noopener">{t.github}</a>
    </nav>

    <div class="nav__actions">
      <a href={otherLangHref} class="nav__lang">{t.langSwitch}</a>
      <span class="nav__launch" title={launchTag}>
        <span class="nav__launch-dot" aria-hidden="true"></span>
        {launchTag}
      </span>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(8, 8, 8, 0.72);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .nav__inner {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 24px;
    height: 60px;
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav__logo {
    display: flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    color: var(--color-text);
    flex-shrink: 0;
    transition: color var(--transition);
  }

  .nav__logo:hover {
    color: var(--brand-primary);
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 2px;
    flex: 1;
  }

  .nav__link {
    padding: 6px 12px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: color var(--transition), background var(--transition);
  }

  .nav__link:hover {
    color: var(--color-text);
    background: rgba(255, 255, 255, 0.06);
  }

  .nav__link--active {
    color: var(--brand-primary);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .nav__lang {
    padding: 6px 12px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: color var(--transition), background var(--transition);
  }

  .nav__lang:hover {
    color: var(--color-text);
    background: rgba(255, 255, 255, 0.06);
  }

  .nav__launch {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 12px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--brand-primary);
    background: var(--brand-primary-subtle);
    border: 1px solid rgba(255, 140, 0, 0.22);
    border-radius: 100px;
    white-space: nowrap;
  }

  .nav__launch-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-primary);
    box-shadow: 0 0 0 0 rgba(255, 140, 0, 0.6);
    animation: nav-pulse 2.4s ease-out infinite;
  }

  @keyframes nav-pulse {
    0% { box-shadow: 0 0 0 0 rgba(255, 140, 0, 0.55); }
    70% { box-shadow: 0 0 0 7px rgba(255, 140, 0, 0); }
    100% { box-shadow: 0 0 0 0 rgba(255, 140, 0, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__launch-dot { animation: none; }
  }

  @media (max-width: 860px) {
    .nav__links {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .nav__inner {
      padding: 0 16px;
      gap: 12px;
    }

    .nav__launch {
      display: none;
    }
  }
</style>
