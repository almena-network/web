---
import type { Lang } from "../data/site";
import { launch, launchLabel } from "../data/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = launch[lang];
const dateLabel = launchLabel(lang);

const units = [
  { key: "days", label: t.units.days },
  { key: "hours", label: t.units.hours },
  { key: "minutes", label: t.units.minutes },
  { key: "seconds", label: t.units.seconds },
];
---

<section id="launch" class="section section--alt launch">
  <div class="page launch__inner">
    <span class="sec-kicker">{t.eyebrow}</span>
    <h2 class="launch__title">{t.title}</h2>

    <div
      class="launch__grid"
      data-countdown
      data-target={launch.date}
      data-done={t.done}
      role="timer"
      aria-label={`${t.title} ${dateLabel}`}
    >
      {
        units.map((u) => (
          <div class="launch__unit">
            <span class="launch__num" data-unit={u.key}>
              ––
            </span>
            <span class="launch__label">{u.label}</span>
          </div>
        ))
      }
    </div>

    <p class="launch__date">{dateLabel}</p>
  </div>
</section>

<style>
  .launch__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .launch__title {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 6px 0 28px;
    color: var(--color-text);
  }

  .launch__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(78px, 116px));
    gap: 14px;
  }

  .launch__grid--done {
    grid-template-columns: 1fr;
  }

  /* Each unit is its own tile, lifted two steps off the page and warmed from the top, so that
     four numbers read as four objects rather than as one strip of text. */
  .launch__unit {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 22px 12px 18px;
    background:
      radial-gradient(
        ellipse 100% 70% at 50% 0%,
        rgba(235, 114, 41, 0.12) 0%,
        transparent 70%
      ),
      linear-gradient(180deg, var(--surface-3) 0%, var(--surface-1) 100%);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
  }

  /* A hairline of the identity colour along the top edge of every tile. */
  .launch__unit::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 22%;
    right: 22%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--brand), transparent);
  }

  .launch__num {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--brand);
    font-variant-numeric: tabular-nums;
  }

  .launch__label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .launch__done {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--brand);
    margin: 0;
  }

  .launch__date {
    margin: 22px 0 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  @media (max-width: 460px) {
    .launch__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      width: 100%;
    }
  }
</style>

<script>
  function initCountdown(el: HTMLElement) {
    const target = new Date(el.dataset.target ?? "").getTime();
    const doneText = el.dataset.done ?? "";
    const fields = ["days", "hours", "minutes", "seconds"] as const;

    const pad = (n: number) => String(n).padStart(2, "0");

    const render = () => {
      const diff = target - Date.now();
      if (diff <= 0) {
        el.classList.add("launch__grid--done");
        el.innerHTML = `<p class="launch__done">${doneText}</p>`;
        return true;
      }
      const s = Math.floor(diff / 1000);
      const values = {
        days: Math.floor(s / 86400),
        hours: Math.floor((s % 86400) / 3600),
        minutes: Math.floor((s % 3600) / 60),
        seconds: s % 60,
      };
      for (const f of fields) {
        const node = el.querySelector<HTMLElement>(`[data-unit="${f}"]`);
        if (node)
          node.textContent = f === "days" ? String(values[f]) : pad(values[f]);
      }
      return false;
    };

    if (render()) return;
    const id = window.setInterval(() => {
      if (render()) window.clearInterval(id);
    }, 1000);
  }

  document
    .querySelectorAll<HTMLElement>("[data-countdown]")
    .forEach((el) => initCountdown(el));
</script>
