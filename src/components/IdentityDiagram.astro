---
import type { Lang } from "../data/landing";
import { identity } from "../data/landing";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = identity[lang].diagram;
---

<figure class="ssi">
  <svg
    class="ssi__svg"
    viewBox="0 0 600 380"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label={`${d.issuer} → ${d.holder} → ${d.verifier}`}
  >
    <defs>
      <marker id="ssi-arr" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
        <polygon points="0 0, 7 3, 0 6" fill="#FF8C00" />
      </marker>
    </defs>

    <style>
      .s-node { fill: rgba(255, 140, 0, 0.1); stroke: #FF8C00; stroke-width: 1.6; }
      .s-holder { fill: rgba(255, 140, 0, 0.16); stroke: #FF8C00; stroke-width: 1.8; }
      .s-name { font-family: Inter, system-ui, sans-serif; font-size: 15px; font-weight: 700; fill: #f0f0f0; }
      .s-edge { stroke: #FF8C00; stroke-width: 2; fill: none; stroke-dasharray: 6 5; marker-end: url(#ssi-arr); }
      .s-lbl { font-family: Inter, system-ui, sans-serif; font-size: 12px; font-weight: 600; fill: #b9b9b9; }
    </style>

    <!-- edges (clockwise trust cycle) -->
    <line class="s-edge" x1="271" y1="113" x2="139" y2="267" />
    <line class="s-edge" x1="154" y1="300" x2="446" y2="300" />
    <line class="s-edge" x1="461" y1="267" x2="329" y2="113" />

    <!-- edge labels -->
    <text class="s-lbl" x="168" y="182" text-anchor="end">{d.issues}</text>
    <text class="s-lbl" x="300" y="330" text-anchor="middle">{d.presents}</text>
    <text class="s-lbl" x="432" y="182" text-anchor="start">{d.trusts}</text>

    <!-- nodes -->
    <circle class="s-node" cx="300" cy="80" r="44" />
    <text class="s-name" x="300" y="85" text-anchor="middle">{d.issuer}</text>

    <circle class="s-holder" cx="110" cy="300" r="44" />
    <text class="s-name" x="110" y="305" text-anchor="middle">{d.holder}</text>

    <circle class="s-node" cx="490" cy="300" r="44" />
    <text class="s-name" x="490" y="305" text-anchor="middle">{d.verifier}</text>
  </svg>
</figure>

<style>
  .ssi {
    margin: 0;
    padding: 28px 24px 20px;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .ssi__svg {
    width: 100%;
    max-width: 600px;
    height: auto;
    display: block;
    margin: 0 auto;
  }
</style>
