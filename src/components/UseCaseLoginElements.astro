---
import type { Lang } from "../data/landing";
import { useCaseAppLogin } from "../data/landing";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useCaseAppLogin[lang];
const e = t.elementsDiagram;
---

<figure class="uc-elements">
  <figcaption class="uc-diagram__caption">
    <h3 class="uc-diagram__title">{t.sections.elements.title}</h3>
    <p class="uc-diagram__subtitle">{t.sections.elements.subtitle}</p>
  </figcaption>
  <svg
    class="uc-elements__svg"
    viewBox="0 0 840 380"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-labelledby="uc-elements-title uc-elements-desc"
  >
    <title id="uc-elements-title">{t.sections.elements.title}</title>
    <desc id="uc-elements-desc">{e.svgDesc}</desc>
    <defs>
      <marker id="uc-el-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
        <polygon points="0 0, 8 4, 0 8" fill="#FB923C" />
      </marker>
      <marker id="uc-el-arrow-purple" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
        <polygon points="0 0, 8 4, 0 8" fill="#8B5CF6" />
      </marker>
      <marker id="uc-el-arrow-soft" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
        <polygon points="0 0, 8 4, 0 8" fill="rgba(251, 146, 60, 0.55)" />
      </marker>
    </defs>

    <style>
      .uc-el-app {
        fill: rgba(255, 255, 255, 0.04);
        stroke: rgba(255, 255, 255, 0.18);
        stroke-width: 1.2;
      }
      .uc-el-app-bar {
        fill: rgba(255, 255, 255, 0.06);
        stroke: rgba(255, 255, 255, 0.1);
      }
      .uc-el-qr-frame {
        fill: rgba(255, 255, 255, 0.04);
        stroke: rgba(251, 146, 60, 0.5);
        stroke-width: 1.2;
      }
      .uc-el-qr-cell { fill: #fafafa; }
      .uc-el-selector {
        fill: rgba(139, 92, 246, 0.08);
        stroke: rgba(139, 92, 246, 0.4);
        stroke-width: 1;
      }
      .uc-el-chip {
        fill: rgba(139, 92, 246, 0.18);
        stroke: rgba(139, 92, 246, 0.55);
      }
      .uc-el-chip--active {
        fill: rgba(251, 146, 60, 0.18);
        stroke: rgba(251, 146, 60, 0.7);
      }
      .uc-el-node-core {
        fill: rgba(139, 92, 246, 0.18);
        stroke: #8B5CF6;
        stroke-width: 1.5;
      }
      .uc-el-mesh-dot {
        fill: rgba(139, 92, 246, 0.22);
        stroke: rgba(139, 92, 246, 0.5);
        stroke-width: 1;
      }
      .uc-el-mesh-link {
        stroke: rgba(139, 92, 246, 0.3);
        stroke-width: 1;
        fill: none;
      }
      .uc-el-phone {
        fill: rgba(251, 146, 60, 0.08);
        stroke: rgba(251, 146, 60, 0.55);
        stroke-width: 1.5;
      }
      .uc-el-phone-screen {
        fill: rgba(255, 255, 255, 0.04);
        stroke: rgba(255, 255, 255, 0.1);
      }
      .uc-el-cap {
        font-family: Inter, system-ui, -apple-system, sans-serif;
        font-size: 11px;
        font-weight: 700;
        fill: #fafafa;
      }
      .uc-el-cap-sm {
        font-family: Inter, system-ui, -apple-system, sans-serif;
        font-size: 9px;
        font-weight: 500;
        fill: #a3a3a3;
      }
      .uc-el-edge-label {
        font-family: Inter, system-ui, -apple-system, sans-serif;
        font-size: 10.5px;
        font-weight: 600;
        fill: #d4d4d8;
      }
      .uc-el-edge-label--muted {
        fill: #a3a3a3;
        font-weight: 500;
      }
      .uc-el-arrow {
        fill: none;
        stroke: #FB923C;
        stroke-width: 1.6;
        marker-end: url(#uc-el-arrow);
      }
      .uc-el-arrow--purple {
        stroke: #8B5CF6;
        marker-end: url(#uc-el-arrow-purple);
      }
      .uc-el-arrow--soft {
        stroke: rgba(251, 146, 60, 0.55);
        stroke-dasharray: 5 4;
        marker-end: url(#uc-el-arrow-soft);
      }
    </style>

    <!-- Integrated app window -->
    <rect class="uc-el-app" x="40" y="60" width="220" height="240" rx="10" />
    <rect class="uc-el-app-bar" x="40" y="60" width="220" height="22" rx="10" />
    <circle cx="55" cy="71" r="3" fill="#a3a3a3" />
    <circle cx="65" cy="71" r="3" fill="#a3a3a3" />
    <circle cx="75" cy="71" r="3" fill="#a3a3a3" />
    <text class="uc-el-cap" x="150" y="100" text-anchor="middle">{e.app.title}</text>

    <!-- QR code (stylized) -->
    <rect class="uc-el-qr-frame" x="98" y="118" width="104" height="104" rx="6" />
    <!-- Position markers -->
    <rect class="uc-el-qr-cell" x="106" y="126" width="20" height="20" />
    <rect x="110" y="130" width="12" height="12" fill="#0c0a09" />
    <rect class="uc-el-qr-cell" x="114" y="134" width="4" height="4" />
    <rect class="uc-el-qr-cell" x="174" y="126" width="20" height="20" />
    <rect x="178" y="130" width="12" height="12" fill="#0c0a09" />
    <rect class="uc-el-qr-cell" x="182" y="134" width="4" height="4" />
    <rect class="uc-el-qr-cell" x="106" y="194" width="20" height="20" />
    <rect x="110" y="198" width="12" height="12" fill="#0c0a09" />
    <rect class="uc-el-qr-cell" x="114" y="202" width="4" height="4" />
    <!-- Random data cells -->
    <g>
      <rect class="uc-el-qr-cell" x="132" y="128" width="4" height="4" />
      <rect class="uc-el-qr-cell" x="140" y="128" width="4" height="4" />
      <rect class="uc-el-qr-cell" x="152" y="128" width="4" height="4" />
      <rect class="uc-el-qr-cell" x="160" y="132" width="4" height="4" />
      <rect class="uc-el-qr-cell" x="136" y="136" width="4" height="4" />
      <rect class="uc-el-qr-cell" x="148" y="140" width="4" height="4" />
      <rect class="uc-el-qr-cell" x="160" y="144" width="4" height="4" />
      <rect class="uc-el-qr-cell" x="132" y="148" width="4" height="4" />
      <rect class="uc-el-qr-cell" x="144" y="152" width="4" height="4" />
      <rect class="uc-el-qr-cell" x="156" y="156" width="4" height="4" />
      <rect class="uc-el-qr-cell" x="168" y="160" width="4" height="4" />
      <rect class="uc-el-qr-cell" x="132" y="164" width="4" height="4" />
      <rect class="uc-el-qr-cell" x="148" y="168" width="4" height="4" />
      <rect class="uc-el-qr-cell" x="160" y="172" width="4" height="4" />
      <rect class="uc-el-qr-cell" x="172" y="176" width="4" height="4" />
      <rect class="uc-el-qr-cell" x="136" y="180" width="4" height="4" />
      <rect class="uc-el-qr-cell" x="148" y="184" width="4" height="4" />
      <rect class="uc-el-qr-cell" x="160" y="188" width="4" height="4" />
      <rect class="uc-el-qr-cell" x="172" y="192" width="4" height="4" />
      <rect class="uc-el-qr-cell" x="136" y="196" width="4" height="4" />
      <rect class="uc-el-qr-cell" x="148" y="200" width="4" height="4" />
      <rect class="uc-el-qr-cell" x="160" y="204" width="4" height="4" />
      <rect class="uc-el-qr-cell" x="172" y="208" width="4" height="4" />
    </g>

    <!-- Node selector -->
    <rect class="uc-el-selector" x="60" y="240" width="180" height="44" rx="8" />
    <text class="uc-el-cap-sm" x="70" y="254" text-anchor="start">{e.qr.title}</text>
    <rect class="uc-el-chip uc-el-chip--active" x="70" y="262" width="44" height="14" rx="3" />
    <rect class="uc-el-chip" x="120" y="262" width="44" height="14" rx="3" />
    <rect class="uc-el-chip" x="170" y="262" width="44" height="14" rx="3" />

    <!-- Public node + mesh -->
    <!-- Mesh dots (background) -->
    <g aria-hidden="true">
      <line class="uc-el-mesh-link" x1="430" y1="78" x2="490" y2="158" />
      <line class="uc-el-mesh-link" x1="540" y1="80" x2="490" y2="158" />
      <line class="uc-el-mesh-link" x1="400" y1="200" x2="490" y2="158" />
      <line class="uc-el-mesh-link" x1="580" y1="200" x2="490" y2="158" />
      <line class="uc-el-mesh-link" x1="420" y1="280" x2="490" y2="158" />
      <line class="uc-el-mesh-link" x1="560" y1="280" x2="490" y2="158" />
      <line class="uc-el-mesh-link" x1="430" y1="78" x2="540" y2="80" />
      <line class="uc-el-mesh-link" x1="400" y1="200" x2="420" y2="280" />
      <line class="uc-el-mesh-link" x1="580" y1="200" x2="560" y2="280" />
      <circle class="uc-el-mesh-dot" cx="430" cy="78" r="9" />
      <circle class="uc-el-mesh-dot" cx="540" cy="80" r="9" />
      <circle class="uc-el-mesh-dot" cx="400" cy="200" r="9" />
      <circle class="uc-el-mesh-dot" cx="580" cy="200" r="9" />
      <circle class="uc-el-mesh-dot" cx="420" cy="280" r="9" />
      <circle class="uc-el-mesh-dot" cx="560" cy="280" r="9" />
    </g>
    <text class="uc-el-cap-sm" x="490" y="60" text-anchor="middle">{e.mesh.title}</text>

    <!-- Public node (active) -->
    <circle class="uc-el-node-core" cx="490" cy="180" r="34" />
    <text class="uc-el-cap" x="490" y="178" text-anchor="middle">{e.node.title}</text>
    <text class="uc-el-cap-sm" x="490" y="194" text-anchor="middle">●</text>

    <!-- Wallet (phone) -->
    <rect class="uc-el-phone" x="660" y="80" width="140" height="220" rx="22" />
    <rect class="uc-el-phone-screen" x="672" y="100" width="116" height="180" rx="12" />
    <!-- Camera viewfinder -->
    <rect x="694" y="118" width="72" height="56" rx="6" fill="rgba(251, 146, 60, 0.06)" stroke="rgba(251, 146, 60, 0.55)" stroke-width="1" stroke-dasharray="4 3" />
    <line x1="704" y1="118" x2="704" y2="125" stroke="#FB923C" stroke-width="1.2" />
    <line x1="694" y1="125" x2="701" y2="125" stroke="#FB923C" stroke-width="1.2" />
    <line x1="756" y1="118" x2="756" y2="125" stroke="#FB923C" stroke-width="1.2" />
    <line x1="759" y1="125" x2="766" y2="125" stroke="#FB923C" stroke-width="1.2" />
    <line x1="704" y1="174" x2="704" y2="167" stroke="#FB923C" stroke-width="1.2" />
    <line x1="694" y1="167" x2="701" y2="167" stroke="#FB923C" stroke-width="1.2" />
    <line x1="756" y1="174" x2="756" y2="167" stroke="#FB923C" stroke-width="1.2" />
    <line x1="759" y1="167" x2="766" y2="167" stroke="#FB923C" stroke-width="1.2" />
    <!-- DID line -->
    <text class="uc-el-cap-sm" x="730" y="198" text-anchor="middle">did:almena:…</text>
    <!-- Approve button -->
    <rect x="694" y="220" width="72" height="22" rx="6" fill="rgba(251, 146, 60, 0.25)" stroke="rgba(251, 146, 60, 0.7)" stroke-width="1" />
    <text class="uc-el-cap-sm" x="730" y="234" text-anchor="middle" style="fill: #fafafa; font-weight: 700;">●</text>
    <text class="uc-el-cap" x="730" y="320" text-anchor="middle">{e.wallet.title}</text>

    <!-- Edges -->
    <!-- App ↔ Node: challenge -->
    <line class="uc-el-arrow" x1="262" y1="170" x2="454" y2="174" />
    <text class="uc-el-edge-label" x="358" y="160" text-anchor="middle">{e.labels.challenge}</text>

    <!-- Node → App: result -->
    <line class="uc-el-arrow" x1="454" y1="190" x2="262" y2="194" />
    <text class="uc-el-edge-label" x="358" y="208" text-anchor="middle">{e.labels.result}</text>

    <!-- Wallet → Node: signed proof -->
    <line class="uc-el-arrow" x1="660" y1="186" x2="525" y2="184" />
    <text class="uc-el-edge-label" x="592" y="174" text-anchor="middle">{e.labels.signed}</text>

    <!-- App QR → Wallet camera (Scan QR) - dashed, curved over the top -->
    <path
      class="uc-el-arrow uc-el-arrow--soft"
      d="M 200 118 C 320 30, 580 30, 700 110"
      fill="none"
    />
    <text class="uc-el-edge-label uc-el-edge-label--muted" x="450" y="40" text-anchor="middle">
      {e.labels.scan}
    </text>

    <!-- Node → Mesh: resolve DID (small purple arrow up) -->
    <path class="uc-el-arrow uc-el-arrow--purple" d="M 478 152 L 438 90" />
    <text class="uc-el-edge-label" x="430" y="120" text-anchor="end">{e.labels.resolve}</text>
  </svg>

  <ul class="uc-elements__legend" aria-label={t.sections.elements.title}>
    <li class="uc-elements__legend-item">
      <span class="uc-elements__legend-title">{e.app.title}</span>
      <span class="uc-elements__legend-text">{e.app.role}</span>
    </li>
    <li class="uc-elements__legend-item">
      <span class="uc-elements__legend-title">{e.qr.title}</span>
      <span class="uc-elements__legend-text">{e.qr.role}</span>
    </li>
    <li class="uc-elements__legend-item">
      <span class="uc-elements__legend-title">{e.wallet.title}</span>
      <span class="uc-elements__legend-text">{e.wallet.role}</span>
    </li>
    <li class="uc-elements__legend-item">
      <span class="uc-elements__legend-title">{e.node.title}</span>
      <span class="uc-elements__legend-text">{e.node.role}</span>
    </li>
    <li class="uc-elements__legend-item">
      <span class="uc-elements__legend-title">{e.mesh.title}</span>
      <span class="uc-elements__legend-text">{e.mesh.role}</span>
    </li>
  </ul>
</figure>

<style>
  .uc-elements {
    margin: 0 auto 32px;
    padding: clamp(14px, 2.5vw, 22px) clamp(12px, 3vw, 24px) 16px;
    border-radius: var(--radius);
    max-width: 100%;
    background: var(--color-glass-bg);
    backdrop-filter: blur(var(--blur));
    -webkit-backdrop-filter: blur(var(--blur));
    border: 1px solid var(--color-glass-border);
  }

  .uc-diagram__caption {
    margin: 0 0 12px;
    text-align: center;
  }

  .uc-diagram__title {
    margin: 0 0 4px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .uc-diagram__subtitle {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .uc-elements__svg {
    width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  .uc-elements__legend {
    list-style: none;
    padding: 0;
    margin: 16px 0 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(8px, 1.8vw, 12px);
  }

  .uc-elements__legend-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .uc-elements__legend-title {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-secondary);
  }

  .uc-elements__legend-text {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.45;
  }

  @media screen and (max-width: 1100px) {
    .uc-elements__legend {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 840px) {
    .uc-elements__legend {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 640px) {
    .uc-elements__legend {
      grid-template-columns: 1fr;
    }
  }
</style>
