---
import type { Lang } from "../data/landing";
import { coin } from "../data/landing";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = coin[lang];
const prefix = lang === "es" ? "/es" : "";
const networkHref = `${prefix}/network/`;

const cardIcons = ["reward", "tokenomics", "staking"];

const ic = (path: string) =>
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${path}</svg>`;

function cardIcon(name: string): string {
  switch (name) {
    case "reward":
      return ic('<circle cx="12" cy="8" r="6"/><path d="M8.5 13.5 7 22l5-3 5 3-1.5-8.5"/>');
    case "tokenomics":
      return ic('<path d="M12 2a10 10 0 1 0 10 10"/><path d="M12 2v10l8-4"/>');
    case "staking":
      return ic('<ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6"/><path d="M4 12v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/>');
    default:
      return ic('<circle cx="12" cy="12" r="9"/>');
  }
}
---

<SiteHeader lang={lang} page="coin" />

<main class="page">
  <!-- ── Hero ── -->
  <section class="hero">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="hero__copy">
      <span class="eyebrow">{t.hero.eyebrow}</span>
      <h1 class="hero__title">{t.hero.title}</h1>
      <p class="hero__subtitle">{t.hero.subtitle}</p>
      <div class="hero__actions">
        <a href="https://docs.almena.network" class="btn btn--primary" target="_blank" rel="noopener">{t.hero.ctaPrimary}</a>
        <a href={networkHref} class="btn btn--ghost">{t.hero.ctaSecondary}</a>
      </div>
    </div>
    <div class="hero__visual" aria-hidden="true">
      <div class="coin">
        <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" class="coin__svg">
          <defs>
            <radialGradient id="coin-face" cx="38%" cy="32%" r="80%">
              <stop offset="0%" stop-color="#ffb457" />
              <stop offset="45%" stop-color="#ff8c00" />
              <stop offset="100%" stop-color="#c96a00" />
            </radialGradient>
            <linearGradient id="coin-rim" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#ffc074" />
              <stop offset="100%" stop-color="#b35f00" />
            </linearGradient>
          </defs>
          <circle cx="100" cy="100" r="92" fill="url(#coin-rim)" />
          <circle cx="100" cy="100" r="80" fill="url(#coin-face)" />
          <circle cx="100" cy="100" r="80" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="1.5" />
          <!-- Platform icon (the brand logo mark) struck into the coin in dark negative. -->
          <g transform="translate(53.5,53.5) scale(0.608)" fill="#0d0d0d" fill-opacity="0.88">
            <path d="M 16.136719 152.691406 C 13.023438 152.164062 10.679688 151.164062 7.679688 149.082031 C 4.53125 146.902344 1.640625 142.5625 0.535156 138.363281 C -0.144531 135.773438 -0.148438 131.636719 0.527344 128.878906 C 2.21875 121.984375 7.1875 116.582031 13.722656 114.527344 C 16.960938 113.511719 21.941406 113.453125 24.273438 114.40625 C 24.878906 114.648438 25.222656 114.691406 25.375 114.535156 C 25.496094 114.410156 26.539062 112.398438 27.6875 110.070312 C 29.660156 106.074219 32.445312 100.550781 35.246094 95.09375 C 37.046875 91.582031 39.421875 86.910156 41.816406 82.167969 C 44.097656 77.648438 46.738281 72.433594 49.359375 67.273438 C 50.277344 65.464844 51.945312 62.160156 53.066406 59.933594 C 54.1875 57.707031 55.570312 54.992188 56.136719 53.910156 C 56.703125 52.824219 58.449219 49.375 60.015625 46.242188 C 61.582031 43.109375 63.4375 39.445312 64.140625 38.101562 C 65.234375 36 65.371094 35.617188 65.105469 35.363281 C 64.933594 35.203125 64.21875 34.574219 63.511719 33.972656 C 61.125 31.9375 59.292969 28.964844 57.96875 24.992188 C 57.179688 22.628906 56.984375 18.609375 57.527344 15.898438 C 58.5625 10.695312 61.542969 6.191406 65.832031 3.355469 C 68.042969 1.894531 69.660156 1.179688 72.082031 0.601562 C 75.867188 -0.304688 79.046875 -0.191406 82.5625 0.980469 C 85.535156 1.96875 87.523438 3.195312 89.980469 5.550781 C 92.707031 8.167969 94.175781 10.703125 95.398438 14.914062 C 95.757812 16.140625 95.847656 17.078125 95.859375 19.621094 C 95.867188 22.523438 95.816406 22.96875 95.257812 24.769531 C 94.085938 28.546875 92.59375 30.992188 89.683594 33.890625 L 87.773438 35.796875 L 90.398438 41.019531 C 91.839844 43.890625 93.675781 47.523438 94.472656 49.089844 C 95.273438 50.65625 97.210938 54.5 98.78125 57.632812 C 100.351562 60.765625 102.195312 64.414062 102.878906 65.738281 C 103.558594 67.0625 105.210938 70.316406 106.542969 72.96875 C 107.878906 75.621094 110.179688 80.152344 111.65625 83.046875 C 113.136719 85.9375 116.23