          </g>
        </svg>
      </div>
    </div>
  </section>

  <!-- ── What is ALMENA ── -->
  <section class="what">
    <h2 class="what__title">{t.what.title}</h2>
    <p class="what__text">{t.what.text}</p>
  </section>

  <!-- ── The coin behind the tech ── -->
  <section class="cards" aria-labelledby="cards-heading">
    <div class="section-head">
      <h2 id="cards-heading" class="section-head__title">{t.cards.title}</h2>
    </div>
    <div class="cards__grid">
      {t.cards.items.map((c, i) => (
        <article class="coin-card">
          <div class="coin-card__icon" aria-hidden="true" set:html={cardIcon(cardIcons[i])} />
          <span class="coin-card__tag">{c.tag}</span>
          <h3 class="coin-card__title">{c.title}</h3>
          <p class="coin-card__text">{c.text}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- ── How a coin is earned ── -->
  <section class="flow" aria-labelledby="flow-heading">
    <div class="section-head">
      <h2 id="flow-heading" class="section-head__title">{t.flow.title}</h2>
      <p class="section-head__subtitle">{t.flow.subtitle}</p>
    </div>
    <div class="flow__grid">
      {t.flow.items.map((f) => (
        <article class="flow-step">
          <span class="flow-step__num">{f.step}</span>
          <h3 class="flow-step__title">{f.title}</h3>
          <p class="flow-step__text">{f.text}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- ── Market (honest, coming at launch) ── -->
  <section class="market">
    <div class="market__inner">
      <span class="market__badge">{t.market.badge}</span>
      <h2 class="market__title">{t.market.title}</h2>
      <p class="market__text">{t.market.text}</p>
    </div>
  </section>

  <!-- ── Final CTA ── -->
  <section class="cta">
    <div class="cta__glow" aria-hidden="true"></div>
    <div class="cta__content">
      <h2 class="cta__title">{t.cta.title}</h2>
      <p class="cta__text">{t.cta.text}</p>
      <div class="cta__actions">
        <a href="https://docs.almena.network" class="btn btn--primary" target="_blank" rel="noopener">{t.cta.ctaPrimary}</a>
        <a href="https://github.com/almena-network" class="btn btn--ghost" target="_blank" rel="noopener">{t.cta.ctaSecondary}</a>
      </div>
    </div>
  </section>
</main>

<SiteFooter lang={lang} />

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 48px;
    align-items: center;
    padding: 80px 0 90px;
  }

  .hero__glow {
    position: absolute;
    top: -40px;
    right: -5%;
    width: 640px;
    height: 460px;
    max-width: 100%;
    background: radial-gradient(ellipse at center, rgba(255, 140, 0, 0.16) 0%, transparent 65%);
    pointer-events: none;
    z-index: -1;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero__title {
    font-size: clamp(2.2rem, 5vw, 3.75rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin: 22px 0;
    background: linear-gradient(170deg, #ffffff 0%, rgba(255, 255, 255, 0.72) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero__subtitle {
    font-size: clamp(1rem, 2vw, 1.1875rem);
    color: var(--color-text-muted);
    margin: 0 0 32px;
    max-width: 52ch;
    line-height: 1.65;
  }

  .hero__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .hero__visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }

  .coin {
    width: 240px;
    max-width: 70%;
    filter: drop-shadow(0 24px 40px rgba(255, 140, 0, 0.25));
    animation: coin-float 6s ease-in-out infinite;
  }

  .coin__svg {
    width: 100%;
    height: auto;
  }

  @keyframes coin-float {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50% { transform: translateY(-14px) rotate(2deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .coin { animation: none; }
  }

  /* ── What ── */
  .what {
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
    padding: 0 0 90px;
  }

  .what__title {
    font-size: clamp(1.6rem, 3.2vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 0 0 18px;
    color: var(--color-text);
  }

  .what__text {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.7;
  }

  /* ── Cards ── */
  .cards {
    padding: 0 0 90px;
  }

  .cards__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .coin-card {
    padding: 32px;
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    transition: border-color var(--transition), transform var(--transition);
  }

  .coin-card:hover {
    border-color: rgba(255, 140, 0, 0.25);
    transform: translateY(-2px);
  }

  .coin-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    border-radius: 12px;
    background: var(--brand-primary-subtle);
    color: var(--brand-primary);
    margin-bottom: 18px;
    border: 1px solid rgba(255, 140, 0, 0.16);
  }

  .coin-card__tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--brand-primary);
    margin-bottom: 8px;
  }

  .coin-card__title {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 12px;
    color: var(--color-text);
  }

  .coin-card__text {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.6;
  }

  /* ── Flow ── */
  .flow {
    padding: 0 0 90px;
  }

  .flow__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .flow-step {
    padding: 28px;
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius);
  }

  .flow-step__num {
    display: block;
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: rgba(255, 140, 0, 0.22);
    line-height: 1;
    margin-bottom: 14px;
  }

  .flow-step__title {
    font-size: 1.0625rem;
    font-weight: 600;
    margin: 0 0 8px;
    color: var(--color-text);
  }

  .flow-step__text {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.6;
  }

  /* ── Market ── */
  .market {
    padding: 0 0 90px;
  }

  .market__inner {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding: 60px 40px;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(ellipse 80% 100% at 50% 0%, rgba(255, 140, 0, 0.1) 0%, transparent 60%),
      var(--color-surface);
    border: 1px solid rgba(255, 140, 0, 0.18);
  }

  .market__badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--brand-primary);
    padding: 5px 12px;
    border: 1px solid rgba(255, 140, 0, 0.22);
    border-radius: 100px;
    background: var(--brand-primary-subtle);
    margin-bottom: 18px;
  }

  .market__title {
    font-size: clamp(1.5rem, 3.2vw, 2.1rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 0 0 14px;
    color: var(--color-text);
  }

  .market__text {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin: 0 auto;
    max-width: 62ch;
    line-height: 1.7;
  }

  /* ── Final CTA ── */
  .cta {
    position: relative;
    overflow: hidden;
    padding: 76px 48px;
    margin: 0 0 100px;
    text-align: center;
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
  }

  .cta__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 90% at 50% 100%, rgba(255, 140, 0, 0.13) 0%, transparent 65%);
    pointer-events: none;
  }

  .cta__content {
    position: relative;
    z-index: 1;
  }

  .cta__title {
    font-size: clamp(1.6rem, 3.4vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 0 0 14px;
    color: var(--color-text);
  }

  .cta__text {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin: 0 auto 30px;
    max-width: 56ch;
    line-height: 1.65;
  }

  .cta__actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ── Responsive ── */
  @media (max-width: 960px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 56px 0 72px;
      text-align: center;
    }

    .hero__copy {
      align-items: center;
    }

    .hero__subtitle {
      margin-inline: auto;
    }

    .hero__visual {
      order: -1;
    }

    .cards__grid {
      grid-template-columns: 1fr;
    }

    .flow__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .coin-card,
    .flow-step {
      padding: 24px;
    }

    .market__inner {
      padding: 44px 24px;
    }

    .cta {
      padding: 48px 24px;
    }
  }
</style>
