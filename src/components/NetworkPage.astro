---
import type { Lang } from "../data/landing";
import { network } from "../data/landing";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import AvailabilityDiagram from "./AvailabilityDiagram.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = network[lang];
const prefix = lang === "es" ? "/es" : "";
const coinHref = `${prefix}/coin/`;

const pillarIcons = ["service", "chain"];

const ic = (path: string) =>
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${path}</svg>`;

function pillarIcon(name: string): string {
  if (name === "service") {
    return ic('<rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><circle cx="7" cy="7.5" r="0.9" fill="currentColor"/><circle cx="7" cy="16.5" r="0.9" fill="currentColor"/>');
  }
  return ic('<rect x="3" y="9" width="6" height="6" rx="1.4"/><rect x="15" y="4" width="6" height="6" rx="1.4"/><rect x="15" y="14" width="6" height="6" rx="1.4"/><path d="M9 12h3M15 7h-1.5a1.5 1.5 0 0 0-1.5 1.5v7A1.5 1.5 0 0 0 13.5 17H15"/>');
}
---

<SiteHeader lang={lang} page="network" />

<main class="page">
  <!-- ── Hero ── -->
  <section class="hero">
    <div class="hero__glow" aria-hidden="true"></div>
    <span class="eyebrow">{t.hero.eyebrow}</span>
    <h1 class="hero__title">{t.hero.title}</h1>
    <p class="hero__subtitle">{t.hero.subtitle}</p>
    <div class="hero__actions">
      <a href="https://github.com/almena-network" class="btn btn--primary" target="_blank" rel="noopener">{t.hero.ctaPrimary}</a>
      <a href={coinHref} class="btn btn--ghost">{t.hero.ctaSecondary}</a>
    </div>
  </section>

  <!-- ── Stats ── -->
  <section class="stats" aria-label={t.stats.title}>
    <div class="stats__grid">
      {t.stats.items.map((s) => (
        <div class="stat">
          <span class="stat__value">{s.value}</span>
          <span class="stat__label">{s.label}</span>
        </div>
      ))}
    </div>
    <p class="stats__note">{t.stats.note}</p>
  </section>

  <!-- ── What ── -->
  <section class="what">
    <h2 class="what__title">{t.what.title}</h2>
    <p class="what__text">{t.what.text}</p>
  </section>

  <!-- ── Availability comparison ── -->
  <section class="diagram-section">
    <AvailabilityDiagram lang={lang} />
  </section>

  <!-- ── Two daemons ── -->
  <section class="pillars" aria-labelledby="pillars-heading">
    <div class="section-head">
      <h2 id="pillars-heading" class="section-head__title">{t.pillars.title}</h2>
      <p class="section-head__subtitle">{t.pillars.subtitle}</p>
    </div>
    <div class="pillars__grid">
      {t.pillars.items.map((p, i) => (
        <article class="pillar-card">
          <div class="pillar-card__icon" aria-hidden="true" set:html={pillarIcon(pillarIcons[i])} />
          <span class="pillar-card__tag">{p.tag}</span>
          <h3 class="pillar-card__title">{p.title}</h3>
          <p class="pillar-card__text">{p.text}</p>
          <ul class="pillar-card__points">
            {p.points.map((pt) => (
              <li>
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                {pt}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <!-- ── Rewards / staking ── -->
  <section class="rewards" aria-labelledby="rewards-heading">
    <div class="section-head">
      <h2 id="rewards-heading" class="section-head__title">{t.rewards.title}</h2>
      <p class="section-head__subtitle">{t.rewards.subtitle}</p>
    </div>
    <div class="rewards__grid">
      {t.rewards.items.map((r) => (
        <article class="reward-step">
          <span class="reward-step__num">{r.step}</span>
          <h3 class="reward-step__title">{r.title}</h3>
          <p class="reward-step__text">{r.text}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- ── Final CTA ── -->
  <section class="cta">
    <div class="cta__glow" aria-hidden="true"></div>
    <div class="cta__content">
      <h2 class="cta__title">{t.cta.title}</h2>
      <p class="cta__text">{t.cta.text}</p>
      <div class="cta__actions">
        <a href="https://github.com/almena-network" class="btn btn--primary" target="_blank" rel="noopener">{t.cta.ctaPrimary}</a>
        <a href={coinHref} class="btn btn--ghost">{t.cta.ctaSecondary}</a>
      </div>
    </div>
  </section>
</main>

<SiteFooter lang={lang} />

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    text-align: center;
    padding: 110px 0 70px;
    max-width: 840px;
    margin: 0 auto;
  }

  .hero__glow {
    position: absolute;
    top: -80px;
    left: 50%;
    transform: translateX(-50%);
    width: 720px;
    height: 420px;
    max-width: 100%;
    background: radial-gradient(ellipse at center, rgba(255, 140, 0, 0.15) 0%, transparent 65%);
    pointer-events: none;
    z-index: -1;
  }

  .eyebrow {
    margin-bottom: 24px;
  }

  .hero__title {
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -0.025em;
    margin: 0 0 22px;
    background: linear-gradient(170deg, #ffffff 0%, rgba(255, 255, 255, 0.72) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero__subtitle {
    font-size: clamp(1rem, 2vw, 1.1875rem);
    color: var(--color-text-muted);
    margin: 0 auto 36px;
    max-width: 60ch;
    line-height: 1.65;
  }

  .hero__actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ── Stats ── */
  .stats {
    padding: 0 0 90px;
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 32px 20px;
    background: var(--color-surface);
  }

  .stat__value {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--brand-primary);
    line-height: 1;
  }

  .stat__label {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-align: center;
  }

  .stats__note {
    margin: 18px auto 0;
    max-width: 54ch;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--color-text-subtle);
  }

  /* ── What ── */
  .what {
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
    padding: 0 0 90px;
  }

  .what__title {
    font-size: clamp(1.6rem, 3.2vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 0 0 18px;
    color: var(--color-text);
  }

  .what__text {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.7;
  }

  /* ── Diagram ── */
  .diagram-section {
    padding: 0 0 90px;
  }

  /* ── Pillars ── */
  .pillars {
    padding: 0 0 90px;
  }

  .pillars__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .pillar-card {
    padding: 32px;
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    transition: border-color var(--transition), transform var(--transition);
  }

  .pillar-card:hover {
    border-color: rgba(255, 140, 0, 0.25);
    transform: translateY(-2px);
  }

  .pillar-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    border-radius: 12px;
    background: var(--brand-primary-subtle);
    color: var(--brand-primary);
    margin-bottom: 18px;
    border: 1px solid rgba(255, 140, 0, 0.16);
  }

  .pillar-card__tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--brand-primary);
    margin-bottom: 8px;
  }

  .pillar-card__title {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 12px;
    color: var(--color-text);
  }

  .pillar-card__text {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0 0 18px;
    line-height: 1.6;
  }

  .pillar-card__points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .pillar-card__points li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.4;
  }

  .pillar-card__points svg {
    color: var(--brand-primary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* ── Rewards ── */
  .rewards {
    padding: 0 0 90px;
  }

  .rewards__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .reward-step {
    position: relative;
    padding: 28px;
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .reward-step__num {
    display: block;
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: rgba(255, 140, 0, 0.22);
    line-height: 1;
    margin-bottom: 14px;
  }

  .reward-step__title {
    font-size: 1.0625rem;
    font-weight: 600;
    margin: 0 0 8px;
    color: var(--color-text);
  }

  .reward-step__text {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.6;
  }

  /* ── Final CTA ── */
  .cta {
    position: relative;
    overflow: hidden;
    padding: 76px 48px;
    margin: 0 0 100px;
    text-align: center;
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
  }

  .cta__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 90% at 50% 100%, rgba(255, 140, 0, 0.13) 0%, transparent 65%);
    pointer-events: none;
  }

  .cta__content {
    position: relative;
    z-index: 1;
  }

  .cta__title {
    font-size: clamp(1.6rem, 3.4vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 0 0 14px;
    color: var(--color-text);
  }

  .cta__text {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin: 0 auto 30px;
    max-width: 56ch;
    line-height: 1.65;
  }

  .cta__actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .stats__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .pillars__grid {
      grid-template-columns: 1fr;
    }

    .rewards__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 72px 0 56px;
    }

    .pillar-card {
      padding: 24px;
    }

    .cta {
      padding: 48px 24px;
    }
  }
</style>
