---
import type { Lang } from "../data/landing";
import { landing } from "../data/landing";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tt = landing[lang].trustTriangle;
---

<section class="trust-tri" aria-labelledby="trust-tri-heading">
  <div class="trust-tri__intro">
    <h2 id="trust-tri-heading" class="trust-tri__title">{tt.title}</h2>
    <p class="trust-tri__subtitle">{tt.subtitle}</p>
  </div>

  <div class="trust-tri__layout">
    <figure class="trust-tri__figure">
      <svg
        class="trust-tri__svg"
        viewBox="0 0 480 400"
        xmlns="http://www.w3.org/2000/svg"
        role="img"
        aria-labelledby="trust-tri-svg-title trust-tri-svg-desc"
      >
        <title id="trust-tri-svg-title">{tt.svgTitle}</title>
        <desc id="trust-tri-svg-desc">{tt.svgDesc}</desc>
        <defs>
          <marker id="tt-arr-issue" markerWidth="10" markerHeight="10" refX="9" refY="5" orient="auto" markerUnits="strokeWidth">
            <path d="M0,0 L10,5 L0,10 z" fill="#FB923C" />
          </marker>
          <marker id="tt-arr-present" markerWidth="10" markerHeight="10" refX="9" refY="5" orient="auto" markerUnits="strokeWidth">
            <path d="M0,0 L10,5 L0,10 z" fill="#A78BFA" />
          </marker>
          <marker id="tt-arr-trust" markerWidth="10" markerHeight="10" refX="9" refY="5" orient="auto" markerUnits="strokeWidth">
            <path d="M0,0 L10,5 L0,10 z" fill="#737373" />
          </marker>
        </defs>

        <style>
          .tt-line-issue {
            stroke: #fb923c;
            stroke-width: 3.5;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
            marker-end: url(#tt-arr-issue);
          }
          .tt-line-present {
            stroke: #a78bfa;
            stroke-width: 3.5;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
            marker-end: url(#tt-arr-present);
          }
          .tt-line-trust {
            stroke: #737373;
            stroke-width: 3;
            fill: none;
            stroke-linecap: round;
            stroke-dasharray: 10 8;
            marker-end: url(#tt-arr-trust);
          }
          .tt-node-holder {
            fill: rgba(251, 146, 60, 0.12);
            stroke: #fb923c;
            stroke-width: 2.5;
          }
          .tt-node-issuer {
            fill: rgba(167, 139, 250, 0.12);
            stroke: #a78bfa;
            stroke-width: 2.5;
          }
          .tt-node-verifier {
            fill: rgba(115, 115, 115, 0.08);
            stroke: #a3a3a3;
            stroke-width: 2.5;
          }
          .tt-cap {
            font-family: Inter, system-ui, -apple-system, sans-serif;
            font-size: 14px;
            font-weight: 700;
            fill: #fafafa;
          }
          .tt-edge {
            font-family: Inter, system-ui, -apple-system, sans-serif;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.06em;
            text-transform: uppercase;
          }
          .tt-edge-issue {
            fill: #fdba74;
          }
          .tt-edge-present {
            fill: #c4b5fd;
          }
          .tt-edge-trust {
            fill: #a3a3a3;
          }
        </style>

        <!-- Holder top, issuer bottom-left, verifier bottom-right -->
        <!-- Arrows: issuer→holder (issue), holder→verifier (present), verifier→issuer (trust); draw edges under nodes -->
        <path class="tt-line-issue" d="M 94.5 281.4 L 215.5 100.6" />
        <path class="tt-line-present" d="M 264.5 100.6 L 385.5 281.4" />
        <path class="tt-line-trust" d="M 366 318 L 114 318" />

        <circle class="tt-node-holder" cx="240" cy="64" r="44" />
        <circle class="tt-node-issuer" cx="70" cy="318" r="44" />
        <circle class="tt-node-verifier" cx="410" cy="318" r="44" />

        <text class="tt-cap" x="240" y="70" text-anchor="middle">{tt.holder.title}</text>
        <text class="tt-cap" x="70" y="324" text-anchor="middle">{tt.issuer.title}</text>
        <text class="tt-cap" x="410" y="324" text-anchor="middle">{tt.verifier.title}</text>

        <text class="tt-edge tt-edge-issue" x="155" y="191" text-anchor="middle" transform="rotate(-56.5 155 191)">{tt.edgeIssue}</text>
        <text class="tt-edge tt-edge-present" x="325" y="191" text-anchor="middle" transform="rotate(56.5 325 191)">{tt.edgePresent}</text>
        <text class="tt-edge tt-edge-trust" x="240" y="302" text-anchor="middle">{tt.edgeTrust}</text>
      </svg>
    </figure>

    <ul class="trust-tri__roles">
      <li class="trust-tri__card trust-tri__card--holder">
        <h3 class="trust-tri__card-title">{tt.holder.title}</h3>
        <p class="trust-tri__card-text">{tt.holder.text}</p>
      </li>
      <li class="trust-tri__card trust-tri__card--issuer">
        <h3 class="trust-tri__card-title">{tt.issuer.title}</h3>
        <p class="trust-tri__card-text">{tt.issuer.text}</p>
      </li>
      <li class="trust-tri__card trust-tri__card--verifier">
        <h3 class="trust-tri__card-title">{tt.verifier.title}</h3>
        <p class="trust-tri__card-text">{tt.verifier.text}</p>
      </li>
    </ul>
  </div>
</section>

<style>
  .trust-tri {
    margin-bottom: 40px;
  }

  .trust-tri__intro {
    text-align: center;
    margin-bottom: 24px;
  }

  .trust-tri__title {
    font-size: 1.35rem;
    font-weight: 600;
    margin: 0 0 6px;
    color: var(--color-primary);
  }

  .trust-tri__subtitle {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0 auto;
    max-width: 52ch;
    line-height: 1.55;
  }

  .trust-tri__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }

  .trust-tri__figure {
    margin: 0;
    padding: 20px 16px 24px;
    border-radius: var(--radius);
    background: var(--color-glass-bg);
    backdrop-filter: blur(var(--blur));
    -webkit-backdrop-filter: blur(var(--blur));
    border: 1px solid var(--color-glass-border);
  }

  .trust-tri__svg {
    width: 100%;
    max-width: 520px;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  .trust-tri__roles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .trust-tri__card {
    padding: 16px 18px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-glass-border);
    background: var(--color-glass-bg);
    border-left-width: 4px;
  }

  .trust-tri__card--holder {
    border-left-color: #fb923c;
  }

  .trust-tri__card--issuer {
    border-left-color: #a78bfa;
  }

  .trust-tri__card--verifier {
    border-left-color: #737373;
  }

  .trust-tri__card-title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 6px;
    color: var(--color-text);
  }

  .trust-tri__card-text {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 900px) {
    .trust-tri__layout {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 640px) {
    .trust-tri__figure {
      padding: 14px 10px 18px;
    }
  }
</style>
