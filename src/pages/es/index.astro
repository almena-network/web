---
/**
 * The portal in es. Both routes are the same page handed a different language.
 */

import LandingLayout from "../../layouts/LandingLayout.astro";
import SitePage from "../../components/SitePage.astro";
import { site } from "../../data/site";

const lang = "es" as const;
const s = site[lang];
---

<LandingLayout title={s.title} description={s.description} lang={lang}>
  <SitePage lang={lang} />
</LandingLayout>
