---
import { langPath, langs, type Lang } from "../data/site";
import { LANGUAGE_KEY } from "../lib/language";
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
  lang: Lang;
}

const { title, description, lang } = Astro.props;

/** Where each language lives, handed to the script below so it holds no paths of its own. */
const homes = Object.fromEntries(langs.map((l) => [l, langPath(l)]));

/**
 * Only the English home greets a visitor in their own language; see `lib/language.ts` for why
 * every other page leaves them where they asked to be.
 */
const greets = lang === "en";
---

<!doctype html>
<html
  lang={lang}
  data-language-key={LANGUAGE_KEY}
  data-language-homes={JSON.stringify(homes)}
  data-language-greets={greets ? "" : undefined}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e1116" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/logo.svg" />
    <link rel="alternate" hreflang="en" href={`${Astro.url.origin}/`} />
    <link rel="alternate" hreflang="es" href={`${Astro.url.origin}/es/`} />
    <link rel="alternate" hreflang="x-default" href={`${Astro.url.origin}/`} />
    <title>{title}</title>
    <script is:inline>
      // Inline and in the head on purpose: this has to settle before anything is painted, or a
      // Spanish reader sees a flash of English first — the half language that is worse than one
      // language, arriving as a flicker instead of a gap.
      //
      // It reads its settings off `<html>` rather than having them compiled in, so that what the
      // page does about language is visible in the page.
      (function () {
        const settings = document.documentElement.dataset;
        if (settings.languageGreets === undefined) return;

        const homes = JSON.parse(settings.languageHomes || "{}");
        let chosen = null;
        try {
          chosen = localStorage.getItem(settings.languageKey);
        } catch {
          // A private window, or site data blocked. Fall through to the browser's own order.
        }
        if (!chosen) {
          const offered = navigator.languages || [navigator.language || ""];
          for (const tag of offered) {
            const primary = String(tag).toLowerCase().split("-")[0];
            if (homes[primary]) {
              chosen = primary;
              break;
            }
          }
        }
        const home = chosen && homes[chosen];
        if (home && home !== location.pathname) {
          location.replace(home + location.search + location.hash);
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
